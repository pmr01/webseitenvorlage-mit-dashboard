---
// Reiter Positionierung: Strategie-Pyramide, Porter's 5 Kräfte, SWOT-Analyse, Persona und Empathy Map.
// Jedes Modell hat eine eigene Inhaltsdatei in src/inhalte/.
import Dashboard from '../../layouts/Dashboard.astro';
import BeispielHinweis from '../../components/BeispielHinweis.astro';
import pyramide from '../../inhalte/strategie-pyramide.json';
import porter from '../../inhalte/porter-5-kraefte.json';
import swot from '../../inhalte/swot-analyse.json';
import persona from '../../inhalte/persona-empathy-map.json';
import Reiter from '../../components/Reiter.astro';

const swotFelder = [
  { titel: 'Stärken', englisch: 'Strengths', punkte: swot.staerken, klasse: 's' },
  { titel: 'Schwächen', englisch: 'Weaknesses', punkte: swot.schwaechen, klasse: 'w' },
  { titel: 'Chancen', englisch: 'Opportunities', punkte: swot.chancen, klasse: 'o' },
  { titel: 'Risiken', englisch: 'Threats', punkte: swot.risiken, klasse: 't' },
];
---
<Dashboard titel="Positionierung" untertitel="Wofür das Unternehmen steht, wie der Markt aussieht und für wen es da ist.">
  <Reiter beschriftung="Modelle" eintraege={[
    { id: 'pyramide', name: 'Strategie-Pyramide' },
    { id: 'porter', name: "Porter's 5 Kräfte" },
    { id: 'swot', name: 'SWOT-Analyse' },
    { id: 'persona', name: 'Persona / Empathy Map' },
  ]} />

  <!-- Strategie-Pyramide -->
  <section id="pyramide" class="abschnitt-modell">
    <h2>Strategie-Pyramide</h2>
    {pyramide.beispiel && <BeispielHinweis datei="src/inhalte/strategie-pyramide.json" />}
    <!-- Echte Pyramide in drei Stufen: Jede Stufe steht in derselben Zeile wie ihr Text und wächst
         mit dessen Höhe. Die Pyramide ist bewusst größer als die Spalte und rechts angeschnitten. -->
    <svg class="pyramide-klein" viewBox="0 0 360 312" role="img" aria-label="Strategie-Pyramide: oben Purpose und Werte, in der Mitte Mission und Vision, unten Strategie">
      <polygon class="s1" points="180,4 236,102 124,102" />
      <polygon class="s2" points="120.6,108 239.4,108 295.4,206 64.6,206" />
      <polygon class="s3" points="61.1,212 298.9,212 356,312 4,312" />
      <text x="180" y="78" text-anchor="middle">1</text><text x="180" y="166" text-anchor="middle">2</text><text x="180" y="270" text-anchor="middle">3</text>
    </svg>
    <div class="pyramide">
      <div class="band b1" aria-hidden="true">
        <svg viewBox="0 0 100 100" preserveAspectRatio="none"><polygon points="50,0 66.67,100 33.33,100" /></svg>
        <span class="band-text"><b>1</b><i>Purpose<br />&amp; Werte</i></span>
      </div>
      <div class="karte text t1">
        <h3><span class="stufe" aria-hidden="true">1</span>Purpose &amp; Werte</h3>
        <p><strong>{pyramide.purpose.text}</strong></p>
        <ul class="punkte">
          {pyramide.purpose.werte.map((w) => <li><strong>{w.wert}</strong><span>{w.erklaerung}</span></li>)}
        </ul>
      </div>
      <div class="band b2" aria-hidden="true">
        <svg viewBox="0 0 100 100" preserveAspectRatio="none"><polygon points="33.33,0 66.67,0 83.33,100 16.67,100" /></svg>
        <span class="band-text"><b>2</b><i>Mission<br />&amp; Vision</i></span>
      </div>
      <div class="karte text t2">
        <h3><span class="stufe" aria-hidden="true">2</span>Mission &amp; Vision</h3>
        <p><strong>Vision:</strong> {pyramide.vision}</p>
        <p><strong>Mission:</strong> {pyramide.mission}</p>
      </div>
      <div class="band b3" aria-hidden="true">
        <svg viewBox="0 0 100 100" preserveAspectRatio="none"><polygon points="16.67,0 83.33,0 100,100 0,100" /></svg>
        <span class="band-text"><b>3</b><i>Strategie</i></span>
      </div>
      <div class="karte text t3">
        <h3><span class="stufe" aria-hidden="true">3</span>Strategie</h3>
        <ul class="punkte">
          {pyramide.strategien.map((st) => <li><strong>{st.strategie}</strong><span>{st.erklaerung}</span></li>)}
        </ul>
      </div>
    </div>
    {pyramide.zusammenfassung && <p class="fazit">{pyramide.zusammenfassung}</p>}
  </section>

  <!-- Porter's 5 Kräfte -->
  <section id="porter" class="abschnitt-modell">
    <h2>Porter's 5 Kräfte</h2>
    {porter.beispiel && <BeispielHinweis datei="src/inhalte/porter-5-kraefte.json" />}
    {porter.einleitung && <p>{porter.einleitung}</p>}
    <div class="porter">
      {porter.kraefte.slice(0, 5).map((k, i) => (
        <div class:list={['karte', 'kraft', `k${i + 1}`]}>
          <h3>{k.titel}</h3>
          <ul class="punkte">
            {k.faktoren.slice(0, 4).map((f) => <li><strong>{f.punkt}</strong><span>{f.begruendung}</span></li>)}
          </ul>
        </div>
      ))}
    </div>
    {porter.fazit && <p class="fazit">{porter.fazit}</p>}
  </section>

  <!-- SWOT-Analyse -->
  <section id="swot" class="abschnitt-modell">
    <h2>SWOT-Analyse</h2>
    {swot.beispiel && <BeispielHinweis datei="src/inhalte/swot-analyse.json" />}
    {swot.einleitung && <p>{swot.einleitung}</p>}
    <div class="swot-matrix">
      <span class="achse oben links">hilfreich</span>
      <span class="achse oben rechts">hinderlich</span>
      <span class="achse seite intern">intern</span>
      <span class="achse seite extern">extern</span>
      <div class="swot">
        {swotFelder.map((f) => (
          <div class:list={['swot-feld', f.klasse]}>
            <span class="buchstabe" aria-hidden="true">{f.englisch[0]}</span>
            <h3>{f.titel} <small>{f.englisch}</small></h3>
            <ul class="punkte">
              {f.punkte.slice(0, 5).map((p) => <li><strong>{p.punkt}</strong><span>{p.begruendung}</span></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
    {swot.fazit && <p class="fazit">{swot.fazit}</p>}
  </section>

  <!-- Persona / Empathy Map -->
  <section id="persona" class="abschnitt-modell">
    <h2>Persona / Empathy Map</h2>
    {persona.beispiel && <BeispielHinweis datei="src/inhalte/persona-empathy-map.json" />}
    <div class="karte">
      <h3>{persona.name}</h3>
      <dl class="empathy">
        {persona.dimensionen.map((d) => (
          <div>
            <dt>{d.frage}</dt>
            <dd><ul>{d.antworten.map((a) => <li>{a}</li>)}</ul></dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Dashboard>

<style>
  .sprungmarken { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
  .sprungmarken a { padding: 6px 12px; border-radius: 999px; background: #fff; border: 1px solid #dde3e6; text-decoration: none; font-weight: 600; font-size: .9rem; }
  .abschnitt-modell { scroll-margin-top: 130px; }

  /* Pyramide: linke Spalte mit drei Stufen, jede so hoch wie ihre Textkarte. Die Pyramide ist 130 %
     so breit wie die Spalte und wird rechts angeschnitten (Mitte bei 65 % der Spalte). */
  .pyramide { --pyr-breite: 130%; --pyr-mitte: 65%; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); column-gap: 20px; row-gap: 10px; align-items: stretch; }
  .band { position: relative; overflow: hidden; min-height: 150px; }
  .band svg { position: absolute; top: 0; left: 0; height: 100%; width: var(--pyr-breite); max-width: none; }
  .pyramide-klein { display: none; }
  .b1 polygon { fill: color-mix(in srgb, var(--haupt) 100%, black 18%); }
  .b2 polygon { fill: var(--haupt); }
  .b3 polygon { fill: color-mix(in srgb, var(--haupt) 72%, white); }
  .band-text { position: absolute; left: var(--pyr-mitte); top: 50%; transform: translate(-50%, -50%); color: #fff; font-weight: 700; font-size: clamp(.95rem, 1.6vw, 1.3rem); line-height: 1.2; text-align: center; white-space: nowrap; }
  .b1 .band-text { top: 76%; font-size: clamp(.8rem, 1.15vw, 1rem); }
  .band-text b { display: none; }
  .band-text i { font-style: normal; }
  .text h3 { display: flex; align-items: center; gap: 8px; font-size: 1rem; margin: 0 0 .6em; }
  .stufe { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; color: #fff; font-size: .78rem; }
  .t1 { border-left: 6px solid color-mix(in srgb, var(--haupt) 100%, black 18%); } .t1 .stufe { background: color-mix(in srgb, var(--haupt) 100%, black 18%); }
  .t2 { border-left: 6px solid var(--haupt); } .t2 .stufe { background: var(--haupt); }
  .t3 { border-left: 6px solid color-mix(in srgb, var(--haupt) 72%, white); } .t3 .stufe { background: color-mix(in srgb, var(--haupt) 72%, white); }
  .text p:last-child { margin-bottom: 0; }
  .text .punkte { margin-top: 10px; }
  @media (max-width: 760px) {
    .pyramide { grid-template-columns: 1fr; }
    .band { display: none; }
    .pyramide-klein { display: block; width: 100%; max-width: 240px; margin: 0 auto 14px; }
    .pyramide-klein polygon { stroke: #fff; stroke-width: 3; }
    .pyramide-klein .s1 { fill: color-mix(in srgb, var(--haupt) 100%, black 18%); }
    .pyramide-klein .s2 { fill: var(--haupt); }
    .pyramide-klein .s3 { fill: color-mix(in srgb, var(--haupt) 72%, white); }
    .pyramide-klein text { fill: #fff; font-weight: 700; font-size: 26px; }
  }

  .porter { display: grid; gap: 12px; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-areas: ". k2 ." "k4 k1 k3" ". k5 ."; }
  .k1 { grid-area: k1; border: 2px solid var(--haupt); } .k2 { grid-area: k2; } .k3 { grid-area: k3; } .k4 { grid-area: k4; } .k5 { grid-area: k5; }
  .kraft h3 { color: var(--haupt); }
  @media (max-width: 900px) { .porter { grid-template-columns: 1fr; grid-template-areas: "k1" "k2" "k3" "k4" "k5"; } }

  /* SWOT als quadratische Matrix: vier gleich große Quadrate, Achsen intern/extern und hilfreich/hinderlich */
  .swot-matrix { display: grid; grid-template-columns: 34px minmax(0, 1fr) minmax(0, 1fr); grid-template-rows: auto auto auto; gap: 6px 10px; max-width: 900px; margin-inline: auto; }
  .achse { font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #5a676d; text-align: center; }
  .achse.oben.links { grid-column: 2; grid-row: 1; }
  .achse.oben.rechts { grid-column: 3; grid-row: 1; }
  .achse.seite { grid-column: 1; writing-mode: vertical-rl; transform: rotate(180deg); align-self: center; }
  .achse.intern { grid-row: 2; }
  .achse.extern { grid-row: 3; }
  .swot { grid-column: 2 / 4; grid-row: 2 / 4; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 10px; }
  .swot-feld { position: relative; aspect-ratio: 1 / 1; overflow: auto; border-radius: 14px; padding: 22px; border: 1px solid; display: flex; flex-direction: column; }
  .swot-feld h3 { font-size: 1.1rem; margin: 0 0 12px; position: relative; }
  .swot-feld small { font-weight: 500; color: #6b777c; }
  .swot-feld .punkte { position: relative; }
  .buchstabe { position: absolute; right: 14px; bottom: -6px; font-size: clamp(4rem, 12vw, 8rem); font-weight: 800; line-height: 1; opacity: .12; pointer-events: none; }
  .s { background: #eef7f1; border-color: #bfe0c9; } .s .buchstabe { color: #3d8b5a; }
  .w { background: #fdf3ea; border-color: #f0d3b6; } .w .buchstabe { color: #c0773a; }
  .o { background: #edf4fb; border-color: #bdd5ec; } .o .buchstabe { color: #2f6fa6; }
  .t { background: #fbeeee; border-color: #ecc4c4; } .t .buchstabe { color: #b04646; }
  @media (max-width: 640px) {
    .swot-matrix { grid-template-columns: 1fr; }
    .achse { display: none; }
    .swot { grid-column: 1; grid-row: auto; grid-template-columns: 1fr; grid-template-rows: none; }
    .swot-feld { aspect-ratio: auto; min-height: 200px; }
  }

  .empathy { display: grid; gap: 12px; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0; }
  .empathy > div { background: #f6f8f9; border-radius: 10px; padding: 12px 14px; }
  .empathy dt { font-weight: 700; color: var(--haupt); margin-bottom: 4px; }
  .empathy dd { margin: 0; }
  .empathy ul { margin: 0; padding-left: 1.1em; }
  @media (max-width: 640px) { .empathy { grid-template-columns: 1fr; } }
</style>
