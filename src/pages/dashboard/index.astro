---
// Reiter Dashboard: Startansicht mit Beispielzahlen und dem Stand aller sechs P.
// Die Kennzahlen oben kommen aus src/inhalte/dashboard-kennzahlen.json.
// Der Stand der Bereiche liest, was im Browser in den anderen Reitern gepflegt wurde
// (Projekte, Kampagnen, Abos, Updates, Checkliste); sonst die Beispieldaten.
import Dashboard from '../../layouts/Dashboard.astro';
import kennzahlen from '../../inhalte/dashboard-kennzahlen.json';
import bmc from '../../inhalte/business-model-canvas.json';
import tools from '../../inhalte/plattform-tools.json';
import projekte from '../../inhalte/projekte.json';
import kampagnen from '../../inhalte/kampagnen.json';
import abos from '../../inhalte/abos.json';
import updates from '../../inhalte/updates.json';
import { konfiguration } from '../../konfiguration.mjs';

const zahl = new Intl.NumberFormat('de-DE');
const k = Object.fromEntries(kennzahlen.kennzahlen.map((x) => [x.name, x]));
const anfragen = k['Anfragen']?.wert ?? 0, besucher = k['Besucher']?.wert ?? 0, budget = k['Marketingbudget']?.wert ?? 0;
const abgeleitet = [
  { name: 'Anfragequote', wert: besucher ? `${(anfragen / besucher * 100).toFixed(1).replace('.', ',')} %` : '–', text: 'Anfragen je 100 Besucher' },
  { name: 'Kosten pro Anfrage', wert: anfragen ? `${zahl.format(Math.round(budget / anfragen))} €` : '–', text: 'Marketingbudget geteilt durch Anfragen' },
];
const bmcBefuellt = Object.values(bmc.felder).filter((f: any) => f.length).length;
const startdaten = { projekte, kampagnen, abos, updates: updates.aufgaben.map((a) => ({ id: a.id, intervall: a.intervall })) };
---
<Dashboard titel="Dashboard" untertitel={`Der Überblick für ${konfiguration.firma.name}: die wichtigsten Zahlen und der Stand in allen sechs Bereichen des 6P-Prinzips.`}>
  {kennzahlen.beispiel && (
    <p class="beispiel-hinweis" role="note"><strong>Beispielzahlen</strong><span>{kennzahlen.hinweis} Datei: <code>src/inhalte/dashboard-kennzahlen.json</code>. Echte Besucherzahlen zeigt der Reiter Performance, sobald Google Analytics verbunden ist.</span></p>
  )}

  <h2 class="db-h2">Kennzahlen <small>{kennzahlen.zeitraum}</small></h2>
  <div class="db-kacheln">
    {kennzahlen.kennzahlen.map((x) => {
      const diff = x.vorher ? Math.round(((x.wert - x.vorher) / x.vorher) * 100) : null;
      return (
        <div class="karte db-kachel">
          <span class="db-name">{x.name}</span>
          <strong>{zahl.format(x.wert)}{x.einheit ? ` ${x.einheit}` : ''}</strong>
          {diff !== null && <span class:list={['db-trend', diff >= 0 ? 'hoch' : 'runter']}>{diff >= 0 ? '▲' : '▼'} {Math.abs(diff)} % zum Vormonat</span>}
          <small>Quelle: {x.quelle}</small>
        </div>
      );
    })}
    {abgeleitet.map((x) => (
      <div class="karte db-kachel abgeleitet">
        <span class="db-name">{x.name}</span>
        <strong>{x.wert}</strong>
        <small>{x.text}</small>
      </div>
    ))}
  </div>

  <h2 class="db-h2">Stand der sechs Bereiche</h2>
  <div class="db-bereiche">
    <a class="karte db-bereich" href="/dashboard/produkt/"><span class="db-nr">1</span><strong>Produkt</strong><span>Business Model Canvas: {bmcBefuellt} von 9 Feldern gefüllt</span></a>
    <a class="karte db-bereich" href="/dashboard/positionierung/"><span class="db-nr">2</span><strong>Positionierung</strong><span>Strategie-Pyramide, Porter, SWOT und Persona</span></a>
    <a class="karte db-bereich" href="/dashboard/promotion/"><span class="db-nr">3</span><strong>Promotion</strong><span id="db-promotion">Storytelling-Checkliste: …</span></a>
    <a class="karte db-bereich" href="/dashboard/prozess/"><span class="db-nr">4</span><strong>Prozess</strong><span id="db-prozess">…</span></a>
    <a class="karte db-bereich" href="/dashboard/plattform/"><span class="db-nr">5</span><strong>Plattform</strong><span id="db-plattform">{tools.tools.length} Tools · Abos: …</span></a>
    <a class="karte db-bereich" href="/dashboard/performance/"><span class="db-nr">6</span><strong>Performance</strong><span id="db-performance">Google Analytics: wird geprüft …</span></a>
  </div>

  <script type="application/json" id="db-start" set:html={JSON.stringify(startdaten)}></script>
</Dashboard>

<script>
  const START = JSON.parse(document.getElementById('db-start')!.textContent || '{}');
  const lesen = (schluessel: string) => { try { return JSON.parse(localStorage.getItem(schluessel) || 'null'); } catch { return null; } };
  const euro = (n: number) => new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(n);
  const setze = (id: string, text: string) => { document.getElementById(id)!.textContent = text; };

  // Promotion: Checkliste
  const haken = lesen('storytelling-checkliste') || {};
  setze('db-promotion', `Storytelling-Checkliste: ${Object.values(haken).filter(Boolean).length} von 15 erledigt`);

  // Prozess: offene Aufgaben, laufende Kampagnen, fällige Updates
  const pm = lesen('prozess-projektmanagement-v2');
  const aufgaben: any[] = pm?.aufgaben ?? START.projekte.aufgaben;
  const offen = aufgaben.filter((a) => a.status !== 'done').length;
  const blockiert = aufgaben.filter((a) => a.status === 'blocked').length;
  const kampagnen: any[] = lesen('prozess-kampagnen') ?? START.kampagnen.kampagnen;
  const laufend = kampagnen.filter((k) => k.status === 'laeuft').length;
  const erledigt = lesen('prozess-updates') || {};
  const heute = new Date(); heute.setHours(0, 0, 0, 0);
  const faellig = START.updates.filter((u: any) => {
    if (!erledigt[u.id]) return true;
    const z = new Date(erledigt[u.id] + 'T00:00:00'); return new Date(z.getFullYear(), z.getMonth() + u.intervall, z.getDate()) <= heute;
  }).length;
  setze('db-prozess', `${offen} offene Aufgaben${blockiert ? ` (${blockiert} blockiert)` : ''} · ${laufend} ${laufend === 1 ? 'laufende Kampagne' : 'laufende Kampagnen'} · ${faellig} Updates fällig`);

  // Plattform: Abo-Kosten pro Monat (aktive Einträge in Euro)
  const eintraege: any[] = lesen('plattform-abos') ?? START.abos.eintraege;
  const monat = eintraege.filter((e) => e.status === 'aktiv' && (e.waehrung || 'EUR') === 'EUR').reduce((s, e) => s + (e.zyklus === 'jaehrlich' ? e.preis / 12 : e.preis), 0);
  const p = document.getElementById('db-plattform')!;
  p.textContent = p.textContent!.replace('Abos: …', `Abos und Domains: ${euro(monat)} pro Monat`);

  // Performance: ist Google Analytics verbunden?
  fetch('/dashboard/api/kennzahlen?tage=7', { credentials: 'same-origin', headers: { accept: 'application/json' } })
    .then((r) => (r.headers.get('content-type') || '').includes('json') ? r.json() : null)
    .then((d) => setze('db-performance', d?.quelle === 'analytics' ? 'Google Analytics verbunden' : d?.fehler && d.fehler !== 'nicht-eingerichtet' ? 'Google Analytics: Verbindung fehlerhaft' : 'Google Analytics noch nicht verbunden (Beispieldaten)'))
    .catch(() => setze('db-performance', 'Google Analytics noch nicht verbunden (Beispieldaten)'));
</script>

<style>
  .db-h2 { font-size: 1.2rem; margin: 8px 0 12px; }
  .db-h2 small { font-size: .85rem; font-weight: 500; color: #67747a; margin-left: 6px; }
  .db-kacheln { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr)); margin-bottom: 28px; }
  .db-kachel { display: flex; flex-direction: column; gap: 2px; }
  .db-kachel.abgeleitet { background: #f9fbfb; }
  .db-name { font-size: .85rem; font-weight: 600; color: #5a676d; }
  .db-kachel strong { font-size: 1.9rem; font-variant-numeric: tabular-nums; line-height: 1.2; }
  .db-trend { font-size: .82rem; font-weight: 600; }
  .db-trend.hoch { color: #22663a; }
  .db-trend.runter { color: #8e2f2f; }
  .db-kachel small { color: #67747a; font-size: .78rem; margin-top: 4px; }
  .db-bereiche { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .db-bereich { display: grid; grid-template-columns: auto 1fr; gap: 2px 12px; align-items: center; text-decoration: none; color: var(--text); transition: border-color .15s; }
  .db-bereich:hover { border-color: var(--haupt); }
  .db-bereich > span:last-child { grid-column: 2; font-size: .9rem; color: #4c595f; }
  .db-nr { grid-row: span 2; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--haupt); color: #fff; font-weight: 700; }
</style>
