---
// Reiter Plattform: die Tools, mit denen gearbeitet wird.
// Liste ändern in src/inhalte/plattform-tools.json ("bedarf": true = nur bei Bedarf).
import Dashboard from '../../layouts/Dashboard.astro';
import daten from '../../inhalte/plattform-tools.json';
const fest = daten.tools.filter((t) => !t.bedarf);
const optional = daten.tools.filter((t) => t.bedarf);
const host = (url: string) => { try { return new URL(url).host.replace(/^www\./, ''); } catch { return url; } };
---
<Dashboard titel="Plattform" untertitel="Die Tools, mit denen Website, Hosting, Auswertung und Werbung laufen.">
  <h2 class="gruppe">Im Einsatz</h2>
  <ul class="tools">
    {fest.map((t) => (
      <li class="karte">
        <h3>{t.name}</h3>
        <p>{t.zweck}</p>
        <a href={t.link} target="_blank" rel="noopener">{host(t.link)} <span aria-hidden="true">↗</span></a>
      </li>
    ))}
  </ul>

  {optional.length > 0 && (
    <>
      <h2 class="gruppe">Bei Bedarf</h2>
      <ul class="tools">
        {optional.map((t) => (
          <li class="karte optional">
            <h3>{t.name}</h3>
            <p>{t.zweck}</p>
            <a href={t.link} target="_blank" rel="noopener">{host(t.link)} <span aria-hidden="true">↗</span></a>
          </li>
        ))}
      </ul>
    </>
  )}
  <p class="hinweis">Die Liste steht in <code>src/inhalte/plattform-tools.json</code> und lässt sich erweitern oder kürzen.</p>
</Dashboard>

<style>
  .gruppe { font-size: 1rem; text-transform: uppercase; letter-spacing: .05em; color: #5a676d; margin: 8px 0 12px; }
  .tools { list-style: none; margin: 0 0 28px; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); }
  .tools .karte { display: flex; flex-direction: column; }
  .tools h3 { font-size: 1.1rem; }
  .tools p { color: #4c595f; flex: 1; }
  .tools a { font-weight: 600; }
  .optional { background: #fbfcfc; border-style: dashed; }
  .hinweis { color: #67747a; font-size: .9rem; }
</style>
