---
// Reiter Prozess → Projekte.
// Projektmanagement mit zwei Vorgehensweisen:
//   Wasserfall: Phasen nacheinander (Projektdefinition → Planung → Umsetzung → Controlling → Abschluss),
//               Meilensteine, Ansichten Phasen / Zeitplan / Liste
//   Agil:       Backlog und Sprints, Ansichten Board / Sprints / Liste
// Ein Klick auf ein Projekt öffnet es oben mit seinen eigenen Ansichten.
// Startdaten aus src/inhalte/projekte.json; Änderungen speichert der Browser.
import Dashboard from '../../../layouts/Dashboard.astro';
import Unterseiten from '../../../components/Unterseiten.astro';
import { PROZESS_SEITEN } from '../../../components/prozess-seiten.mjs';
import startdaten from '../../../inhalte/projekte.json';
import '../../../styles/pm.css';
---
<Dashboard titel="Prozess" untertitel="Projekte und Aufgaben planen: wer macht was bis wann, und wo hakt es?">
  <Unterseiten seiten={PROZESS_SEITEN} />

  <p class="beispiel-hinweis" role="note">
    <strong>Beispiel</strong>
    <span>Dieses Projektmanagement ist ein Beispiel ohne Datenbank: Änderungen speichert nur dieser Browser, andere sehen sie nicht. Sichern Sie Ihren Stand über „Als Datei sichern“.{' '}
    <strong>Für den echten Einsatz im Team</strong> richten Sie eine Datenbank ein, zum Beispiel <a href="https://neon.tech" target="_blank" rel="noopener">Neon</a> (kostenloser Einstieg, siehe Reiter Plattform). Bitten Sie dann Ihr KI-Tool: „Speichere Projekte und Aufgaben im Reiter Prozess in meiner Neon-Datenbank.“</span>
  </p>

  <!-- Geöffnetes Projekt erscheint hier oben -->
  <section id="pm-detail" class="pm-detail" hidden aria-live="polite"></section>

  <section aria-labelledby="pm-projekte-titel" class="pm-projekte-bereich">
    <div class="pm-kopf">
      <h2 id="pm-projekte-titel">Projekte</h2>
      <div class="pm-knoepfe"><button type="button" class="pm-btn primaer" data-aktion="neues-projekt">+ Projekt</button></div>
    </div>
    <div class="pm-projekte" id="pm-projekte"></div>
  </section>

  <section id="pm-alle" class="pm-alle" aria-labelledby="pm-alle-titel">
    <div class="pm-kopf">
      <h2 id="pm-alle-titel">Aufgaben</h2>
      <div class="pm-knoepfe">
        <label class="pm-filter">Projekt <select class="pm-select" id="pm-alle-filter"></select></label>
        <div class="pm-ansicht" role="tablist" aria-label="Ansicht" id="pm-alle-ansicht">
          <button type="button" role="tab" data-ansicht="board">Board</button>
          <button type="button" role="tab" data-ansicht="liste">Liste</button>
          <button type="button" role="tab" data-ansicht="zeitplan">Gantt</button>
        </div>
        <button type="button" class="pm-btn primaer" data-aktion="neue-aufgabe">+ Aufgabe</button>
      </div>
    </div>
    <div id="pm-alle-inhalt"></div>
  </section>

  <details class="karte pm-methode">
    <summary><h2>Vorschlag: Wasserfall oder agil?</h2></summary>
    <div class="pm-methode-raster">
      <div>
        <h3><span class="pm-marke blau">Wasserfall</span> Phasen nacheinander</h3>
        <p><strong>Wann:</strong> Ziel, Umfang und Termin stehen fest, zum Beispiel ein Website-Relaunch, ein Messeauftritt oder ein Kundenprojekt mit Festpreis.</p>
        <p><strong>Ablauf:</strong> fünf Phasen wie im Projektmanagement-Kurs: Projektdefinition → Planung → Umsetzung → Controlling → Abschluss. Jede Phase endet mit einem <strong>Meilenstein</strong> (◆), zum Beispiel „Lastenheft freigegeben“ oder „Website live“. Änderungen am Umfang werden bewusst entschieden und im Lasten- oder Pflichtenheft nachgetragen.</p>
        <p><strong>Ansichten:</strong> Phasen (Fortschritt je Phase), Zeitplan (Balken mit Meilensteinen), Liste.</p>
      </div>
      <div>
        <h3><span class="pm-marke lila">Agil</span> in kurzen Sprints</h3>
        <p><strong>Wann:</strong> Das beste Ergebnis zeigt sich erst beim Ausprobieren, zum Beispiel Newsletter, Social Media, Kampagnen oder neue Produktideen.</p>
        <p><strong>Ablauf:</strong> Ideen sammeln sich im <strong>Backlog</strong>. Zu Beginn jedes <strong>Sprints</strong> (meist 2 Wochen) wählt das Team, was es schafft. Am Ende zeigt es das Ergebnis (Review), bespricht, was besser laufen kann (Retrospektive), und plant den nächsten Sprint.</p>
        <p><strong>Ansichten:</strong> Board (Spalten nach Status, Filter nach Sprint), Sprints (Backlog und Sprints mit Zeitraum), Liste.</p>
      </div>
    </div>
    <p class="pm-klein"><strong>Tipp:</strong> Viele Teams mischen beides. Rahmen, Termin und Budget planen sie im Wasserfall, die Umsetzung erledigen sie in Sprints. Das Vorgehen legen Sie je Projekt im Projektformular fest.</p>
  </details>

  <div class="pm-daten">
    <button type="button" class="pm-link" data-aktion="exportieren">Als Datei sichern</button>
    <label class="pm-link">Datei laden<input type="file" accept="application/json,.json" id="pm-import" hidden /></label>
    <button type="button" class="pm-link" data-aktion="zuruecksetzen">Beispieldaten wiederherstellen</button>
  </div>

  <dialog id="pm-dialog-aufgabe" class="pm-dialog" aria-labelledby="pm-dialog-aufgabe-titel">
    <form method="dialog" id="pm-form-aufgabe">
      <h2 id="pm-dialog-aufgabe-titel">Aufgabe</h2>
      <label class="breit">Titel<input name="titel" required maxlength="200" /></label>
      <label>Projekt<select name="projekt" required></select></label>
      <label data-nur="wasserfall">Phase<select name="phase"></select></label>
      <label data-nur="agil">Sprint<select name="sprint"></select></label>
      <label>Zuständig<input name="zustaendig" maxlength="60" list="pm-personen" /></label>
      <datalist id="pm-personen"></datalist>
      <label>Status<select name="status"></select></label>
      <label>Start<input name="start" type="date" /></label>
      <label>Fällig<input name="faellig" type="date" /></label>
      <label class="haken breit" data-nur="wasserfall"><input name="meilenstein" type="checkbox" /> Meilenstein (Ende einer Phase oder wichtiger Termin)</label>
      <fieldset class="breit pm-prio"><legend>Priorität (optional, für die Eisenhower-Ansicht)</legend>
        <label class="haken"><input name="wichtig" type="checkbox" /> wichtig</label>
        <label class="haken"><input name="dringend" type="checkbox" /> dringend</label>
      </fieldset>
      <label class="breit">Fortschritt: <output name="fortschritt-anzeige">0 %</output><input name="fortschritt" type="range" min="0" max="100" step="5" value="0" /></label>
      <label class="breit">Beschreibung<textarea name="beschreibung" rows="3" maxlength="2000"></textarea></label>
      <div class="pm-dialog-knoepfe breit">
        <button type="button" class="pm-btn gefahr" data-aktion="aufgabe-loeschen">Löschen</button>
        <span></span>
        <button type="button" class="pm-btn" data-aktion="schliessen">Abbrechen</button>
        <button type="submit" class="pm-btn primaer">Speichern</button>
      </div>
    </form>
  </dialog>

  <dialog id="pm-dialog-projekt" class="pm-dialog" aria-labelledby="pm-dialog-projekt-titel">
    <form method="dialog" id="pm-form-projekt">
      <h2 id="pm-dialog-projekt-titel">Projekt</h2>
      <label class="breit">Name<input name="name" required maxlength="120" /></label>
      <label>Kunde<input name="kunde" maxlength="120" /></label>
      <label>Status<select name="status"></select></label>
      <label>Vorgehen<select name="vorgehen"><option value="wasserfall">Wasserfall (Phasen)</option><option value="agil">Agil (Sprints)</option></select></label>
      <label data-nur="agil">Sprintlänge<select name="sprintWochen"><option value="1">1 Woche</option><option value="2">2 Wochen</option><option value="3">3 Wochen</option><option value="4">4 Wochen</option></select></label>
      <label>Start<input name="start" type="date" /></label>
      <label>Fällig<input name="faellig" type="date" /></label>
      <label>Wert in Euro<input name="wert" type="number" min="0" step="1" /></label>
      <label class="breit">Notizen<textarea name="notizen" rows="3" maxlength="2000"></textarea></label>
      <div class="pm-dialog-knoepfe breit">
        <button type="button" class="pm-btn gefahr" data-aktion="projekt-loeschen">Löschen</button>
        <span></span>
        <button type="button" class="pm-btn" data-aktion="schliessen">Abbrechen</button>
        <button type="submit" class="pm-btn primaer">Speichern</button>
      </div>
    </form>
  </dialog>

  <script type="application/json" id="pm-startdaten" set:html={JSON.stringify(startdaten)}></script>
</Dashboard>

<script>
  type ProjektStatus = 'planned' | 'active' | 'on-hold' | 'completed';
  type AufgabeStatus = 'todo' | 'in_progress' | 'blocked' | 'done';
  type Vorgehen = 'wasserfall' | 'agil';
  type Projekt = { id: string; name: string; kunde: string; status: ProjektStatus; vorgehen: Vorgehen; sprintWochen: number; start: string; faellig: string; wert: number; notizen: string; ansicht: string };
  type Aufgabe = { id: string; projekt: string; titel: string; phase: string; sprint: number; meilenstein: boolean; wichtig: boolean; dringend: boolean; zustaendig: string; status: AufgabeStatus; start: string; faellig: string; fortschritt: number; beschreibung: string };
  type Daten = { version: 2; projekte: Projekt[]; aufgaben: Aufgabe[] };

  const SPEICHER = 'prozess-projektmanagement-v2';
  const ROH = JSON.parse(document.getElementById('pm-startdaten')!.textContent || '{}');
  const PHASEN: string[] = ROH.phasen || ['Projektdefinition', 'Planung', 'Umsetzung', 'Controlling', 'Abschluss'];
  const PROJEKT_STATUS: Record<ProjektStatus, [string, string]> = { planned: ['Geplant', 'blau'], active: ['Aktiv', 'gruen'], 'on-hold': ['Pausiert', 'gelb'], completed: ['Abgeschlossen', ''] };
  const AUFGABE_STATUS: Record<AufgabeStatus, string> = { todo: 'Offen', in_progress: 'In Arbeit', blocked: 'Blockiert', done: 'Erledigt' };
  const ANSICHTEN: Record<Vorgehen, [string, string][]> = {
    wasserfall: [['phasen', 'Phasen'], ['board', 'Board'], ['liste', 'Liste'], ['zeitplan', 'Gantt'], ['eisenhower', 'Eisenhower']],
    agil: [['board', 'Board'], ['sprints', 'Sprints'], ['liste', 'Liste'], ['zeitplan', 'Gantt'], ['eisenhower', 'Eisenhower']],
  };
  const TAG = 86400000;
  const datum = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
  const datumKurz = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: '2-digit' });
  const euro = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });

  // ---------- Hilfsfunktionen ----------
  function el<K extends keyof HTMLElementTagNameMap>(tag: K, attrs: Record<string, any> = {}, ...kinder: (Node | string | null | false | undefined)[]) {
    const e = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) {
      if (v === undefined || v === null || v === false) continue;
      if (k.startsWith('on') && typeof v === 'function') e.addEventListener(k.slice(2), v);
      else if (k === 'class') e.className = v;
      else e.setAttribute(k, v === true ? '' : String(v));
    }
    for (const k of kinder) if (k !== null && k !== undefined && k !== false) e.append(k);
    return e;
  }
  const heute = () => { const d = new Date(); d.setHours(0, 0, 0, 0); return d; };
  const isoTag = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  const verschoben = (tage: number | null | undefined) => { if (tage === null || tage === undefined) return ''; const d = heute(); d.setDate(d.getDate() + tage); return isoTag(d); };
  const alsDatum = (s: string) => (s ? new Date(s + 'T00:00:00') : null);
  const zeige = (s: string) => (s ? datum.format(alsDatum(s)!) : '–');
  const neueId = (p: string) => p + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
  const begrenzen = (n: unknown, min: number, max: number) => Math.min(max, Math.max(min, Number(n) || 0));
  const ueberfaellig = (a: Aufgabe) => a.status !== 'done' && !!a.faellig && alsDatum(a.faellig)! < heute();
  const fortschrittVon = (a: Aufgabe) => (a.status === 'done' ? 100 : a.fortschritt);
  const mittel = (liste: Aufgabe[]) => (liste.length ? Math.round(liste.reduce((s, a) => s + fortschrittVon(a), 0) / liste.length) : 0);

  // ---------- Daten ----------
  function startdaten(): Daten {
    return {
      version: 2,
      projekte: (ROH.projekte || []).map((p: any) => pruefeProjekt({ ...p, start: verschoben(p.start), faellig: verschoben(p.faellig) })),
      aufgaben: (ROH.aufgaben || []).map((a: any) => pruefeAufgabe({ ...a, start: verschoben(a.start), faellig: verschoben(a.faellig) })),
    };
  }
  const text = (v: unknown, max = 2000) => String(v ?? '').slice(0, max);
  const tag = (v: unknown) => (/^\d{4}-\d{2}-\d{2}$/.test(String(v)) ? String(v) : '');
  function pruefeProjekt(p: any): Projekt {
    const vorgehen: Vorgehen = p.vorgehen === 'agil' ? 'agil' : 'wasserfall';
    const ansicht = ANSICHTEN[vorgehen].some(([k]) => k === p.ansicht) ? p.ansicht : ANSICHTEN[vorgehen][0][0];
    return {
      id: text(p.id, 40) || neueId('p'), name: text(p.name, 120) || 'Ohne Namen', kunde: text(p.kunde, 120),
      status: (p.status in PROJEKT_STATUS ? p.status : 'planned') as ProjektStatus, vorgehen, sprintWochen: begrenzen(p.sprintWochen || 2, 1, 4),
      start: tag(p.start), faellig: tag(p.faellig), wert: begrenzen(p.wert, 0, 1e9), notizen: text(p.notizen), ansicht,
    };
  }
  function pruefeAufgabe(a: any): Aufgabe {
    return {
      id: text(a.id, 40) || neueId('a'), projekt: String(a.projekt), titel: text(a.titel, 200) || 'Ohne Titel',
      phase: PHASEN.includes(a.phase) ? a.phase : PHASEN.includes(a.kategorie) ? a.kategorie : 'Umsetzung',
      sprint: begrenzen(a.sprint, 0, 99), meilenstein: !!a.meilenstein,
      // Ohne eigene Angabe gilt eine Aufgabe als dringend, wenn sie in den nächsten 7 Tagen fällig ist
      wichtig: a.wichtig === undefined ? true : !!a.wichtig,
      dringend: a.dringend === undefined ? (!!tag(a.faellig) && (alsDatum(tag(a.faellig))!.getTime() - heute().getTime()) / 86400000 <= 7) : !!a.dringend,
      zustaendig: text(a.zustaendig, 60),
      status: (a.status in AUFGABE_STATUS ? a.status : 'todo') as AufgabeStatus, start: tag(a.start), faellig: tag(a.faellig),
      fortschritt: begrenzen(a.fortschritt, 0, 100), beschreibung: text(a.beschreibung),
    };
  }
  function pruefen(d: any): Daten | null {
    if (!d || !Array.isArray(d.projekte) || !Array.isArray(d.aufgaben)) return null;
    const projekte = d.projekte.map(pruefeProjekt);
    const ids = new Set(projekte.map((p: Projekt) => p.id));
    return { version: 2, projekte, aufgaben: d.aufgaben.filter((a: any) => ids.has(String(a.projekt))).map(pruefeAufgabe) };
  }
  function laden(): Daten {
    try { const d = pruefen(JSON.parse(localStorage.getItem(SPEICHER) || 'null')); if (d) return d; } catch { /* kein Speicher */ }
    return startdaten();
  }
  let daten = laden();
  function speichern() { try { localStorage.setItem(SPEICHER, JSON.stringify(daten)); } catch { /* nur Sitzung */ } zeichnen(); }

  // ---------- Auswahl (im Adressfeld, damit Zurück-Taste und Lesezeichen funktionieren) ----------
  const ausgewaehlt = () => { const id = decodeURIComponent(location.hash.replace(/^#projekt=/, '')); return daten.projekte.find((p) => p.id === id) || null; };
  function oeffnen(p: Projekt | null) {
    history.pushState(null, '', p ? `#projekt=${encodeURIComponent(p.id)}` : location.pathname);
    zeichnen();
    if (p) document.getElementById('pm-detail')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  window.addEventListener('popstate', zeichnen);
  window.addEventListener('hashchange', () => { zeichnen(); if (ausgewaehlt()) document.getElementById('pm-detail')!.scrollIntoView({ block: 'start' }); });

  const aufgabenVon = (p: Projekt) => daten.aufgaben.filter((a) => a.projekt === p.id);
  const fortschrittProjekt = (p: Projekt) => (p.status === 'completed' ? 100 : mittel(aufgabenVon(p)));

  // ---------- Sprints ----------
  function sprintZeitraum(p: Projekt, n: number): [Date, Date] | null {
    if (!p.start || n < 1) return null;
    const s = alsDatum(p.start)!; s.setDate(s.getDate() + (n - 1) * p.sprintWochen * 7);
    const e = new Date(s); e.setDate(e.getDate() + p.sprintWochen * 7 - 1);
    return [s, e];
  }
  function aktuellerSprint(p: Projekt) {
    if (!p.start) return 1;
    const diff = Math.floor((heute().getTime() - alsDatum(p.start)!.getTime()) / TAG);
    return Math.max(1, Math.floor(diff / (p.sprintWochen * 7)) + 1);
  }
  const maxSprint = (p: Projekt) => Math.max(aktuellerSprint(p) + 1, ...aufgabenVon(p).map((a) => a.sprint), 3);
  const sprintName = (p: Projekt, n: number) => {
    if (n === 0) return 'Backlog';
    const z = sprintZeitraum(p, n);
    return `Sprint ${n}${z ? ` (${datumKurz.format(z[0])}–${datumKurz.format(z[1])})` : ''}`;
  };

  // ---------- Bausteine ----------
  function statusAuswahl(a: Aufgabe) {
    const s = el('select', { class: 'pm-select', 'aria-label': `Status von ${a.titel}` }, ...(Object.keys(AUFGABE_STATUS) as AufgabeStatus[]).map((k) => el('option', { value: k }, AUFGABE_STATUS[k]))) as HTMLSelectElement;
    s.value = a.status;
    s.addEventListener('change', () => { a.status = s.value as AufgabeStatus; if (a.status === 'done') a.fortschritt = 100; speichern(); });
    return s;
  }
  function statusMarke(a: Aufgabe) {
    const farbe = { todo: '', in_progress: 'blau', blocked: 'rot', done: 'gruen' }[a.status];
    return el('span', { class: `pm-marke ${farbe}` }, AUFGABE_STATUS[a.status]);
  }
  const titelKnopf = (a: Aufgabe) => el('button', { type: 'button', class: 'pm-link', onclick: () => aufgabeDialog(a, null) }, a.meilenstein ? `◆ ${a.titel}` : a.titel);

  // ---------- Projektkarten ----------
  function projektKarte(p: Projekt, kompakt: boolean) {
    const aufgaben = aufgabenVon(p);
    const offen = aufgaben.filter((a) => a.status !== 'done').length;
    const blockiert = aufgaben.filter((a) => a.status === 'blocked').length;
    const f = fortschrittProjekt(p);
    const [statusText, statusFarbe] = PROJEKT_STATUS[p.status];
    return el('button', { type: 'button', class: `pm-projekt${kompakt ? ' kompakt' : ''}`, 'aria-label': `Projekt ${p.name} öffnen`, onclick: () => oeffnen(p) },
      el('span', { class: 'pm-projekt-kopf' }, el('strong', {}, p.name), el('span', { class: 'pm-marken' }, el('span', { class: `pm-marke ${p.vorgehen === 'agil' ? 'lila' : 'blau'}` }, p.vorgehen === 'agil' ? 'Agil' : 'Wasserfall'), el('span', { class: `pm-marke ${statusFarbe}` }, statusText))),
      kompakt ? null : el('span', { class: 'pm-klein' }, p.kunde || ' '),
      el('span', { class: 'pm-balken', role: 'progressbar', 'aria-valuenow': f, 'aria-valuemin': 0, 'aria-valuemax': 100, 'aria-label': 'Fortschritt' }, el('span', { style: `width:${f}%` })),
      el('span', { class: 'pm-projekt-fuss' }, el('span', {}, `${f} %`), el('span', {}, `${offen} offen${blockiert ? `, ${blockiert} blockiert` : ''}`), p.faellig ? el('span', {}, `bis ${zeige(p.faellig)}`) : null, !kompakt && p.wert ? el('span', {}, euro.format(p.wert)) : null),
    );
  }

  // ---------- Detail: geöffnetes Projekt ----------
  function detail(p: Projekt) {
    const box = document.getElementById('pm-detail')!;
    const f = fortschrittProjekt(p);
    const [statusText, statusFarbe] = PROJEKT_STATUS[p.status];
    const ansichtKnoepfe = el('div', { class: 'pm-ansicht', role: 'tablist', 'aria-label': 'Ansicht' }, ...ANSICHTEN[p.vorgehen].map(([k, name]) =>
      el('button', { type: 'button', role: 'tab', 'aria-selected': String(p.ansicht === k), onclick: () => { p.ansicht = k; speichern(); } }, name)));
    const inhalt = p.ansicht === 'phasen' ? phasen(p) : p.ansicht === 'zeitplan' ? zeitplan(aufgabenVon(p), p) : p.ansicht === 'board' ? board(aufgabenVon(p), p) : p.ansicht === 'sprints' ? sprints(p) : p.ansicht === 'eisenhower' ? eisenhower(aufgabenVon(p), false) : liste(aufgabenVon(p), p);
    box.replaceChildren(
      el('button', { type: 'button', class: 'pm-link pm-zurueck', onclick: () => oeffnen(null) }, '← Alle Projekte'),
      el('div', { class: 'karte pm-detail-kopf' },
        el('div', { class: 'pm-detail-titel' },
          el('h2', {}, p.name),
          el('span', { class: 'pm-marken' }, el('span', { class: `pm-marke ${p.vorgehen === 'agil' ? 'lila' : 'blau'}` }, p.vorgehen === 'agil' ? `Agil · Sprints à ${p.sprintWochen} ${p.sprintWochen === 1 ? 'Woche' : 'Wochen'}` : 'Wasserfall · 5 Phasen'), el('span', { class: `pm-marke ${statusFarbe}` }, statusText)),
        ),
        el('div', { class: 'pm-detail-daten' },
          p.kunde ? el('span', {}, el('small', {}, 'Kunde'), p.kunde) : null,
          el('span', {}, el('small', {}, 'Zeitraum'), `${zeige(p.start)} – ${zeige(p.faellig)}`),
          p.wert ? el('span', {}, el('small', {}, 'Wert'), euro.format(p.wert)) : null,
          el('span', { class: 'pm-detail-fortschritt' }, el('small', {}, `Fortschritt ${f} %`), el('span', { class: 'pm-balken' }, el('span', { style: `width:${f}%` }))),
        ),
        p.notizen ? el('p', { class: 'pm-klein' }, p.notizen) : null,
        el('div', { class: 'pm-kopf pm-detail-leiste' }, ansichtKnoepfe, el('div', { class: 'pm-knoepfe' },
          el('button', { type: 'button', class: 'pm-btn', onclick: () => projektDialog(p) }, 'Projekt bearbeiten'),
          el('button', { type: 'button', class: 'pm-btn primaer', onclick: () => aufgabeDialog(null, p) }, '+ Aufgabe'))),
      ),
      inhalt,
    );
    box.hidden = false;
  }

  // Wasserfall: Phasen nebeneinander
  function phasen(p: Projekt) {
    const aufgaben = aufgabenVon(p);
    return el('div', { class: 'pm-phasen' }, ...PHASEN.map((phase, i) => {
      const liste = aufgaben.filter((a) => a.phase === phase).sort((x, y) => (x.faellig || '9').localeCompare(y.faellig || '9'));
      const f = mittel(liste);
      const starts = liste.map((a) => a.start || a.faellig).filter(Boolean).sort();
      const enden = liste.map((a) => a.faellig || a.start).filter(Boolean).sort();
      const fertig = liste.length > 0 && liste.every((a) => a.status === 'done');
      return el('section', { class: `pm-phase${fertig ? ' fertig' : ''}` },
        el('h3', {}, el('span', { class: 'pm-phase-nr' }, fertig ? '✓' : String(i + 1)), phase),
        el('p', { class: 'pm-klein' }, starts.length ? `${datumKurz.format(alsDatum(starts[0])!)} – ${datumKurz.format(alsDatum(enden[enden.length - 1])!)}` : 'noch keine Termine'),
        el('span', { class: 'pm-balken' }, el('span', { style: `width:${f}%` })),
        el('ul', {}, ...liste.map((a) => el('li', { class: a.status === 'done' ? 'erledigt' : '' }, titelKnopf(a), el('span', { class: 'pm-phase-fuss' }, statusMarke(a), a.zustaendig ? el('span', { class: 'pm-person' }, a.zustaendig) : null, a.faellig ? el('span', { class: ueberfaellig(a) ? 'pm-faellig ueber' : 'pm-faellig' }, datumKurz.format(alsDatum(a.faellig)!)) : null)))),
        liste.length ? null : el('p', { class: 'pm-leer' }, 'Keine Aufgaben'),
        el('button', { type: 'button', class: 'pm-link pm-klein', onclick: () => aufgabeDialog(null, p, { phase }) }, '+ Aufgabe in dieser Phase'),
      );
    }));
  }

  // Gruppen für Liste und Gantt: Übersicht nach Projekt, Wasserfall nach Phase, agil nach Sprint
  function gruppieren(alle: Aufgabe[], p: Projekt | null): [string, Aufgabe[]][] {
    if (!p) return daten.projekte.map((x) => [x.name, alle.filter((a) => a.projekt === x.id)] as [string, Aufgabe[]]);
    if (p.vorgehen === 'agil') return [0, ...Array.from({ length: maxSprint(p) }, (_, i) => i + 1)].map((n) => [sprintName(p, n), alle.filter((a) => a.sprint === n)] as [string, Aufgabe[]]);
    return PHASEN.map((ph) => [ph, alle.filter((a) => a.phase === ph)] as [string, Aufgabe[]]);
  }

  // Gantt: Balken von Start bis Fälligkeit, Meilensteine als Raute
  function zeitplan(alle: Aufgabe[], p: Projekt | null) {
    const aufgaben = alle.filter((a) => a.start || a.faellig);
    if (!aufgaben.length) return el('p', { class: 'karte pm-leer' }, 'Noch keine Aufgaben mit Datum.');
    const anfang = (a: Aufgabe) => alsDatum(a.start || a.faellig)!.getTime();
    const ende = (a: Aufgabe) => alsDatum(a.faellig || a.start)!.getTime();
    const min = Math.min(...aufgaben.map(anfang), heute().getTime()) - 3 * TAG;
    const max = Math.max(...aufgaben.map(ende), heute().getTime()) + 4 * TAG;
    const pz = (t: number) => ((t - min) / (max - min)) * 100;
    const heuteLinie = () => el('span', { class: 'pm-heute-linie', style: `left:${pz(heute().getTime())}%` });

    const wochen: HTMLElement[] = [];
    const w = new Date(min); w.setDate(w.getDate() + ((8 - w.getDay()) % 7));
    for (; w.getTime() <= max; w.setDate(w.getDate() + 7)) wochen.push(el('span', { class: 'pm-woche', style: `left:${pz(w.getTime())}%` }, datumKurz.format(w)));

    const zeilen: HTMLElement[] = [];
    for (const [gruppe, l] of gruppieren(aufgaben, p)) {
      const liste = l.sort((x, y) => anfang(x) - anfang(y));
      if (!liste.length) continue;
      zeilen.push(el('div', { class: 'pm-zeile gruppe' }, el('span', { class: 'pm-zeile-name' }, gruppe), el('div', { class: 'pm-spur' }, heuteLinie())));
      for (const a of liste) {
        const links = pz(anfang(a));
        const breite = Math.max(1.2, pz(ende(a) + TAG) - links);
        const titel = `${a.titel}: ${zeige(a.start)} bis ${zeige(a.faellig)} (${AUFGABE_STATUS[a.status]})`;
        zeilen.push(el('div', { class: 'pm-zeile' },
          el('span', { class: 'pm-zeile-name' }, titelKnopf(a)),
          el('div', { class: 'pm-spur' }, heuteLinie(), a.meilenstein
            ? el('span', { class: `pm-meilenstein s-${a.status}`, style: `left:${pz(ende(a) + TAG / 2)}%`, title: titel })
            : el('span', { class: `pm-zeitbalken s-${a.status}`, style: `left:${links}%;width:${breite}%`, title: titel }, el('span', { class: 'pm-zeitbalken-fortschritt', style: `width:${fortschrittVon(a)}%` })))));
      }
    }
    return el('div', { class: 'karte pm-zeitplan' },
      el('div', { class: 'pm-zeile pm-achse' }, el('span'), el('div', { class: 'pm-spur' }, el('span', { class: 'pm-heute-marke', style: `left:${pz(heute().getTime())}%` }, 'Heute'), ...wochen)),
      ...zeilen,
      el('div', { class: 'pm-legende' },
        ...(Object.keys(AUFGABE_STATUS) as AufgabeStatus[]).map((k) => el('span', {}, el('i', { class: `pm-zeitbalken s-${k}`, style: 'position:static;display:inline-block' }), AUFGABE_STATUS[k])),
        el('span', {}, '◆ Meilenstein')));
  }

  // Board nach Status; bei agilen Projekten mit Sprint-Filter
  let boardSprint: Record<string, string> = {};
  function board(alle: Aufgabe[], p: Projekt | null) {
    const agil = !!p && p.vorgehen === 'agil';
    if (!agil) return el('div', { class: 'pm-board' }, ...boardSpalten(alle, p));
    const auswahl = boardSprint[p!.id] ?? String(aktuellerSprint(p!));
    const filter = el('select', { class: 'pm-select', 'aria-label': 'Sprint anzeigen' },
      el('option', { value: 'alle' }, 'Alle Sprints und Backlog'),
      ...Array.from({ length: maxSprint(p) }, (_, i) => el('option', { value: String(i + 1) }, `${sprintName(p, i + 1)}${i + 1 === aktuellerSprint(p) ? ' – aktuell' : ''}`)),
      el('option', { value: '0' }, 'Backlog')) as HTMLSelectElement;
    filter.value = auswahl;
    filter.addEventListener('change', () => { boardSprint[p!.id] = filter.value; zeichnen(); });
    const sichtbar = alle.filter((a) => auswahl === 'alle' || a.sprint === Number(auswahl));
    return el('div', {}, el('label', { class: 'pm-filter' }, 'Sprint ', filter), el('div', { class: 'pm-board' }, ...boardSpalten(sichtbar, p)));
  }
  function boardSpalten(sichtbar: Aufgabe[], p: Projekt | null) {
    return (Object.keys(AUFGABE_STATUS) as AufgabeStatus[]).map((status) => {
      const liste = sichtbar.filter((a) => a.status === status);
      const spalte = el('div', { class: `pm-spalte s-${status}` },
        el('h3', {}, AUFGABE_STATUS[status], el('span', { class: 'pm-anzahl' }, String(liste.length))),
        ...liste.map((a) => karte(a, p)),
        liste.length ? null : el('p', { class: 'pm-leer' }, 'Keine Aufgaben'));
      spalte.addEventListener('dragover', (e) => { e.preventDefault(); spalte.classList.add('ziel'); });
      spalte.addEventListener('dragleave', () => spalte.classList.remove('ziel'));
      spalte.addEventListener('drop', (e) => {
        e.preventDefault(); spalte.classList.remove('ziel');
        const a = daten.aufgaben.find((x) => x.id === e.dataTransfer?.getData('text/plain'));
        if (a && a.status !== status) { a.status = status; if (status === 'done') a.fortschritt = 100; speichern(); }
      });
      return spalte;
    });
  }
  function karte(a: Aufgabe, p: Projekt | null) {
    const k = el('article', { class: 'pm-karte', draggable: 'true' },
      titelKnopf(a),
      el('span', { class: 'pm-klein' }, !p ? `${daten.projekte.find((x) => x.id === a.projekt)?.name ?? ''}` : p.vorgehen === 'agil' ? sprintName(p, a.sprint).replace(/ \(.*\)/, '') : a.phase),
      el('span', { class: 'pm-karte-fuss' }, a.zustaendig ? el('span', { class: 'pm-person' }, a.zustaendig) : el('span'), a.faellig ? el('span', { class: ueberfaellig(a) ? 'pm-faellig ueber' : 'pm-faellig' }, datumKurz.format(alsDatum(a.faellig)!)) : null),
      a.fortschritt > 0 && a.status !== 'done' ? el('span', { class: 'pm-balken' }, el('span', { style: `width:${a.fortschritt}%` })) : null,
      el('label', { class: 'pm-karte-status' }, 'Status ', statusAuswahl(a)));
    k.addEventListener('dragstart', (e) => { e.dataTransfer?.setData('text/plain', a.id); k.classList.add('zieht'); });
    k.addEventListener('dragend', () => k.classList.remove('zieht'));
    return k;
  }

  // Agil: Backlog und Sprints untereinander
  function sprints(p: Projekt) {
    const aufgaben = aufgabenVon(p);
    const aktuell = aktuellerSprint(p);
    const gruppen = [0, ...Array.from({ length: maxSprint(p) }, (_, i) => i + 1)];
    return el('div', { class: 'pm-sprints' }, ...gruppen.map((n) => {
      const liste = aufgaben.filter((a) => a.sprint === n);
      const erledigt = liste.filter((a) => a.status === 'done').length;
      const zustand = n === 0 ? 'Ideen und Aufgaben, die noch keinem Sprint zugeordnet sind' : n < aktuell ? 'abgeschlossen' : n === aktuell ? 'läuft gerade' : 'geplant';
      return el('section', { class: `karte pm-sprint${n === aktuell ? ' aktuell' : ''}${n === 0 ? ' backlog' : ''}` },
        el('div', { class: 'pm-kopf' },
          el('h3', {}, sprintName(p, n), n === aktuell ? el('span', { class: 'pm-marke gruen' }, 'aktuell') : null),
          el('span', { class: 'pm-klein' }, n === 0 ? `${liste.length} Einträge` : `${erledigt} von ${liste.length} erledigt · ${zustand}`)),
        n === 0 ? el('p', { class: 'pm-klein' }, zustand) : null,
        liste.length ? el('ul', { class: 'pm-sprint-liste' }, ...liste.map((a) => {
          const verschieben = el('select', { class: 'pm-select', 'aria-label': `${a.titel} in Sprint verschieben` }, ...gruppen.map((m) => el('option', { value: String(m) }, m === 0 ? 'Backlog' : `Sprint ${m}`))) as HTMLSelectElement;
          verschieben.value = String(a.sprint);
          verschieben.addEventListener('change', () => { a.sprint = Number(verschieben.value); speichern(); });
          return el('li', { class: a.status === 'done' ? 'erledigt' : '' }, titelKnopf(a), a.zustaendig ? el('span', { class: 'pm-person' }, a.zustaendig) : el('span'), statusAuswahl(a), verschieben);
        })) : el('p', { class: 'pm-leer' }, 'Noch nichts geplant.'),
        el('button', { type: 'button', class: 'pm-link pm-klein', onclick: () => aufgabeDialog(null, p, { sprint: n }) }, n === 0 ? '+ Idee in den Backlog' : '+ Aufgabe in diesen Sprint'));
    }));
  }

  // Eisenhower-Matrix: offene Aufgaben nach Wichtigkeit und Dringlichkeit
  const QUADRANTEN: { wichtig: boolean; dringend: boolean; titel: string; tun: string; klasse: string }[] = [
    { wichtig: true, dringend: true, titel: 'Sofort erledigen', tun: 'wichtig und dringend: selbst und jetzt', klasse: 'q1' },
    { wichtig: true, dringend: false, titel: 'Einplanen', tun: 'wichtig, nicht dringend: Termin festlegen', klasse: 'q2' },
    { wichtig: false, dringend: true, titel: 'Delegieren', tun: 'dringend, nicht wichtig: abgeben', klasse: 'q3' },
    { wichtig: false, dringend: false, titel: 'Streichen oder später', tun: 'weder noch: bewusst weglassen', klasse: 'q4' },
  ];
  function eisenhower(alle: Aufgabe[], mitProjekt: boolean) {
    const offen = alle.filter((a) => a.status !== 'done');
    const feld = (q: (typeof QUADRANTEN)[number]) => {
      const liste = offen.filter((a) => a.wichtig === q.wichtig && a.dringend === q.dringend).sort((x, y) => (x.faellig || '9').localeCompare(y.faellig || '9'));
      const box = el('section', { class: `pm-quadrant ${q.klasse}`, 'aria-label': q.titel },
        el('h3', {}, q.titel, el('span', { class: 'pm-anzahl' }, String(liste.length))),
        el('p', { class: 'pm-klein' }, q.tun),
        el('ul', {}, ...liste.map((a) => {
          const projekt = daten.projekte.find((p) => p.id === a.projekt);
          const li = el('li', { draggable: 'true' }, titelKnopf(a),
            el('span', { class: 'pm-phase-fuss' }, mitProjekt && projekt ? el('span', { class: 'pm-klein' }, projekt.name) : null, statusMarke(a), a.zustaendig ? el('span', { class: 'pm-person' }, a.zustaendig) : null,
              a.faellig ? el('span', { class: ueberfaellig(a) ? 'pm-faellig ueber' : 'pm-faellig' }, datumKurz.format(alsDatum(a.faellig)!)) : null));
          li.addEventListener('dragstart', (e) => e.dataTransfer?.setData('text/plain', a.id));
          return li;
        })),
        liste.length ? null : el('p', { class: 'pm-leer' }, 'Keine offenen Aufgaben'));
      box.addEventListener('dragover', (e) => { e.preventDefault(); box.classList.add('ziel'); });
      box.addEventListener('dragleave', () => box.classList.remove('ziel'));
      box.addEventListener('drop', (e) => {
        e.preventDefault(); box.classList.remove('ziel');
        const a = daten.aufgaben.find((x) => x.id === e.dataTransfer?.getData('text/plain'));
        if (a) { a.wichtig = q.wichtig; a.dringend = q.dringend; speichern(); }
      });
      return box;
    };
    return el('div', { class: 'karte pm-eisenhower' },
      el('div', { class: 'pm-achse-y', 'aria-hidden': 'true' }, el('span', {}, 'wichtig'), el('span', {}, 'nicht wichtig')),
      el('div', { class: 'pm-achse-x', 'aria-hidden': 'true' }, el('span', {}, 'dringend'), el('span', {}, 'nicht dringend')),
      el('div', { class: 'pm-matrix' }, feld(QUADRANTEN[0]), feld(QUADRANTEN[1]), feld(QUADRANTEN[2]), feld(QUADRANTEN[3])),
      el('p', { class: 'pm-klein pm-matrix-hinweis' }, 'Optional: Aufgaben per Maus in ein anderes Feld ziehen oder im Aufgabenformular „wichtig“ und „dringend“ setzen. Erledigte Aufgaben werden ausgeblendet.'));
  }

  // Liste gruppiert nach Projekt, Phase oder Sprint
  function liste(alle: Aufgabe[], p: Projekt | null) {
    const belegt = gruppieren(alle, p).filter(([, l]) => l.length);
    if (!belegt.length) return el('p', { class: 'karte pm-leer' }, 'Noch keine Aufgaben. Legen Sie mit „+ Aufgabe“ die erste an.');
    return el('div', { class: 'karte pm-tabelle-rahmen' }, el('table', { class: 'pm-tabelle' },
      el('thead', {}, el('tr', {}, ...['Aufgabe', 'Zuständig', 'Status', 'Start', 'Fällig', 'Fortschritt'].map((t) => el('th', { scope: 'col' }, t)))),
      ...belegt.map(([name, l]) => el('tbody', {},
        el('tr', { class: 'pm-gruppe' }, el('th', { colspan: 6, scope: 'colgroup' }, `${name} (${l.length})`)),
        ...l.sort((x, y) => (x.faellig || '9').localeCompare(y.faellig || '9')).map((a) => el('tr', { class: a.status === 'done' ? 'erledigt' : '' },
          el('td', {}, titelKnopf(a)), el('td', {}, a.zustaendig || '–'), el('td', {}, statusAuswahl(a)), el('td', {}, zeige(a.start)),
          el('td', { class: ueberfaellig(a) ? 'pm-faellig ueber' : '' }, zeige(a.faellig)),
          el('td', {}, el('span', { class: 'pm-balken klein' }, el('span', { style: `width:${fortschrittVon(a)}%` })), ` ${fortschrittVon(a)} %`)))))));
  }

  // ---------- Übersicht ohne geöffnetes Projekt ----------
  let uebersichtFilter = 'alle';
  let uebersichtAnsicht = 'board';
  try { uebersichtAnsicht = localStorage.getItem('prozess-uebersicht-ansicht') || 'board'; } catch { /* ohne Speicher */ }
  document.querySelectorAll<HTMLButtonElement>('#pm-alle-ansicht [data-ansicht]').forEach((b) => b.addEventListener('click', () => {
    uebersichtAnsicht = b.dataset.ansicht!;
    try { localStorage.setItem('prozess-uebersicht-ansicht', uebersichtAnsicht); } catch { /* ohne Speicher */ }
    zeichnen();
  }));
  document.getElementById('pm-alle-filter')!.addEventListener('change', (e) => { uebersichtFilter = (e.target as HTMLSelectElement).value; zeichnen(); });

  // ---------- Zeichnen ----------
  function zeichnen() {
    const p = ausgewaehlt();
    const box = document.getElementById('pm-detail')!;
    if (p) detail(p); else { box.hidden = true; box.replaceChildren(); }
    document.getElementById('pm-alle')!.hidden = !!p;
    if (!p) {
      const filter = document.getElementById('pm-alle-filter') as HTMLSelectElement;
      filter.replaceChildren(el('option', { value: 'alle' }, 'Alle Projekte'), ...daten.projekte.map((x) => el('option', { value: x.id }, x.name)));
      if (uebersichtFilter !== 'alle' && !daten.projekte.some((x) => x.id === uebersichtFilter)) uebersichtFilter = 'alle';
      filter.value = uebersichtFilter;
      const sichtbar = daten.aufgaben.filter((a) => uebersichtFilter === 'alle' || a.projekt === uebersichtFilter);
      document.querySelectorAll<HTMLButtonElement>('#pm-alle-ansicht [data-ansicht]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.ansicht === uebersichtAnsicht)));
      document.getElementById('pm-alle-inhalt')!.replaceChildren(uebersichtAnsicht === 'liste' ? liste(sichtbar, null) : uebersichtAnsicht === 'zeitplan' ? zeitplan(sichtbar, null) : board(sichtbar, null));
    }
    document.getElementById('pm-projekte-titel')!.textContent = p ? 'Weitere Projekte' : 'Projekte';
    const andere = daten.projekte.filter((x) => x !== p);
    const raster = document.getElementById('pm-projekte')!;
    raster.className = `pm-projekte${p ? ' kompakt' : ''}`;
    raster.replaceChildren(...andere.map((x) => projektKarte(x, !!p)));
    if (!daten.projekte.length) raster.append(el('p', { class: 'pm-leer' }, 'Noch keine Projekte. Legen Sie mit „+ Projekt“ das erste an.'));
    else if (!p) raster.append(el('p', { class: 'pm-leer pm-tipp' }, 'Klicken Sie auf ein Projekt, um seine Aufgaben zu öffnen.'));
    document.getElementById('pm-personen')!.replaceChildren(...[...new Set(daten.aufgaben.map((a) => a.zustaendig).filter(Boolean))].map((n) => el('option', { value: n })));
  }

  // ---------- Dialoge ----------
  const dlgA = document.getElementById('pm-dialog-aufgabe') as HTMLDialogElement;
  const formA = document.getElementById('pm-form-aufgabe') as HTMLFormElement;
  const dlgP = document.getElementById('pm-dialog-projekt') as HTMLDialogElement;
  const formP = document.getElementById('pm-form-projekt') as HTMLFormElement;
  const feld = (f: HTMLFormElement, n: string) => f.elements.namedItem(n) as HTMLInputElement;
  let aktA: Aufgabe | null = null;
  let aktP: Projekt | null = null;

  (formA.elements.namedItem('status') as HTMLSelectElement).append(...(Object.keys(AUFGABE_STATUS) as AufgabeStatus[]).map((k) => el('option', { value: k }, AUFGABE_STATUS[k])));
  (formA.elements.namedItem('phase') as HTMLSelectElement).append(...PHASEN.map((ph) => el('option', { value: ph }, ph)));
  (formP.elements.namedItem('status') as HTMLSelectElement).append(...(Object.keys(PROJEKT_STATUS) as ProjektStatus[]).map((k) => el('option', { value: k }, PROJEKT_STATUS[k][0])));
  feld(formA, 'fortschritt').addEventListener('input', () => { (formA.elements.namedItem('fortschritt-anzeige') as HTMLOutputElement).value = `${feld(formA, 'fortschritt').value} %`; });

  function vorgehenFelder(f: HTMLFormElement, vorgehen: string) {
    f.querySelectorAll<HTMLElement>('[data-nur]').forEach((e) => { e.hidden = e.dataset.nur !== vorgehen; });
  }
  function sprintOptionen(p: Projekt) {
    const s = formA.elements.namedItem('sprint') as HTMLSelectElement;
    s.replaceChildren(el('option', { value: '0' }, 'Backlog'), ...Array.from({ length: maxSprint(p) + 1 }, (_, i) => el('option', { value: String(i + 1) }, sprintName(p, i + 1))));
  }
  const projektFeld = formA.elements.namedItem('projekt') as HTMLSelectElement;
  projektFeld.addEventListener('change', () => { const p = daten.projekte.find((x) => x.id === projektFeld.value)!; vorgehenFelder(formA, p.vorgehen); sprintOptionen(p); });
  feld(formP, 'vorgehen').addEventListener('change', () => vorgehenFelder(formP, feld(formP, 'vorgehen').value));

  function aufgabeDialog(a: Aufgabe | null, p: Projekt | null, vorgabe: Partial<Aufgabe> = {}) {
    const projekt = a ? daten.projekte.find((x) => x.id === a.projekt)! : p ?? ausgewaehlt() ?? daten.projekte[0];
    if (!projekt) { alert('Legen Sie zuerst ein Projekt an.'); return; }
    aktA = a;
    projektFeld.replaceChildren(...daten.projekte.map((x) => el('option', { value: x.id }, x.name)));
    sprintOptionen(projekt);
    const w: any = a ?? { titel: '', projekt: projekt.id, phase: 'Umsetzung', sprint: projekt.vorgehen === 'agil' ? aktuellerSprint(projekt) : 0, meilenstein: false, zustaendig: '', status: 'todo', start: isoTag(heute()), faellig: '', fortschritt: 0, beschreibung: '', ...vorgabe };
    for (const n of ['titel', 'projekt', 'phase', 'sprint', 'zustaendig', 'status', 'start', 'faellig', 'fortschritt', 'beschreibung']) feld(formA, n).value = String(w[n] ?? '');
    feld(formA, 'meilenstein').checked = !!w.meilenstein;
    feld(formA, 'wichtig').checked = w.wichtig !== false;
    feld(formA, 'dringend').checked = !!w.dringend;
    (formA.elements.namedItem('fortschritt-anzeige') as HTMLOutputElement).value = `${w.fortschritt} %`;
    vorgehenFelder(formA, projekt.vorgehen);
    document.getElementById('pm-dialog-aufgabe-titel')!.textContent = a ? 'Aufgabe bearbeiten' : 'Neue Aufgabe';
    (formA.querySelector('[data-aktion="aufgabe-loeschen"]') as HTMLElement).hidden = !a;
    dlgA.showModal(); feld(formA, 'titel').focus();
  }
  function projektDialog(p: Projekt | null) {
    aktP = p;
    const w: any = p ?? { name: '', kunde: '', status: 'planned', vorgehen: 'wasserfall', sprintWochen: 2, start: isoTag(heute()), faellig: '', wert: '', notizen: '' };
    for (const n of ['name', 'kunde', 'status', 'vorgehen', 'sprintWochen', 'start', 'faellig', 'wert', 'notizen']) feld(formP, n).value = String(w[n] ?? '');
    vorgehenFelder(formP, w.vorgehen);
    document.getElementById('pm-dialog-projekt-titel')!.textContent = p ? 'Projekt bearbeiten' : 'Neues Projekt';
    (formP.querySelector('[data-aktion="projekt-loeschen"]') as HTMLElement).hidden = !p;
    dlgP.showModal(); feld(formP, 'name').focus();
  }

  formA.addEventListener('submit', (e) => {
    e.preventDefault();
    const w = (n: string) => feld(formA, n).value.trim();
    const neu = pruefeAufgabe({ id: aktA?.id ?? neueId('a'), projekt: w('projekt'), titel: w('titel'), phase: w('phase'), sprint: w('sprint'), meilenstein: feld(formA, 'meilenstein').checked, wichtig: feld(formA, 'wichtig').checked, dringend: feld(formA, 'dringend').checked, zustaendig: w('zustaendig'), status: w('status'), start: w('start'), faellig: w('faellig'), fortschritt: w('fortschritt'), beschreibung: w('beschreibung') });
    if (neu.status === 'done') neu.fortschritt = 100;
    if (aktA) Object.assign(aktA, neu); else daten.aufgaben.push(neu);
    dlgA.close(); speichern();
  });
  formP.addEventListener('submit', (e) => {
    e.preventDefault();
    const w = (n: string) => feld(formP, n).value.trim();
    const neu = pruefeProjekt({ id: aktP?.id ?? neueId('p'), name: w('name'), kunde: w('kunde'), status: w('status'), vorgehen: w('vorgehen'), sprintWochen: w('sprintWochen'), start: w('start'), faellig: w('faellig'), wert: w('wert'), notizen: w('notizen'), ansicht: aktP?.vorgehen === w('vorgehen') ? aktP?.ansicht : '' });
    if (aktP) Object.assign(aktP, neu); else daten.projekte.push(neu);
    dlgP.close();
    if (!aktP) { speichern(); oeffnen(neu); } else speichern();
  });

  document.addEventListener('click', (e) => {
    const knopf = (e.target as HTMLElement).closest<HTMLElement>('[data-aktion]');
    if (!knopf) return;
    const aktion = knopf.dataset.aktion;
    if (aktion === 'neues-projekt') projektDialog(null);
    else if (aktion === 'neue-aufgabe') aufgabeDialog(null, daten.projekte.find((x) => x.id === uebersichtFilter) ?? null);
    else if (aktion === 'schliessen') (knopf.closest('dialog') as HTMLDialogElement).close();
    else if (aktion === 'aufgabe-loeschen' && aktA && confirm(`Aufgabe „${aktA.titel}“ löschen?`)) { daten.aufgaben = daten.aufgaben.filter((a) => a !== aktA); dlgA.close(); speichern(); }
    else if (aktion === 'projekt-loeschen' && aktP) {
      const p = aktP; const n = aufgabenVon(p).length;
      if (confirm(`Projekt „${p.name}“${n ? ` mit ${n} Aufgaben` : ''} löschen?`)) { daten.projekte = daten.projekte.filter((x) => x !== p); daten.aufgaben = daten.aufgaben.filter((a) => a.projekt !== p.id); dlgP.close(); speichern(); oeffnen(null); }
    } else if (aktion === 'exportieren') {
      const a = el('a', { href: URL.createObjectURL(new Blob([JSON.stringify(daten, null, 2)], { type: 'application/json' })), download: `projekte-${isoTag(heute())}.json` }) as HTMLAnchorElement;
      document.body.append(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    } else if (aktion === 'zuruecksetzen' && confirm('Alle eigenen Projekte und Aufgaben in diesem Browser durch die Beispieldaten ersetzen?')) { daten = startdaten(); speichern(); oeffnen(null); }
  });
  document.getElementById('pm-import')!.addEventListener('change', async (e) => {
    const datei = (e.target as HTMLInputElement).files?.[0];
    if (!datei) return;
    try {
      const d = pruefen(JSON.parse(await datei.text()));
      if (!d) throw new Error();
      if (confirm(`${d.projekte.length} Projekte und ${d.aufgaben.length} Aufgaben laden? Der bisherige Stand in diesem Browser wird ersetzt.`)) { daten = d; speichern(); oeffnen(null); }
    } catch { alert('Die Datei konnte nicht gelesen werden. Erwartet wird eine Datei, die mit „Als Datei sichern“ erstellt wurde.'); }
    (e.target as HTMLInputElement).value = '';
  });

  zeichnen();
</script>

