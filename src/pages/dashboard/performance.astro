---
// Reiter Performance (6. P): die Kennzahlen der Website aus Google Analytics.
// Die Werte kommen von der Serverfunktion netlify/functions/kennzahlen.mjs (Adresse /dashboard/api/kennzahlen).
// Ist sie nicht eingerichtet, zeigt die Seite Beispieldaten aus public/daten/beispieldaten.json.
import Dashboard from '../../layouts/Dashboard.astro';
import kanaele from '../../inhalte/performance-kanaele.json';
import { konfiguration } from '../../konfiguration.mjs';
const messId = konfiguration.analytics.messId.trim();
const ANL = '/dashboard/anleitungen/google-analytics/';
const schritte = [
  { id: 'messid', titel: 'Besuche erfassen', text: 'Mess-ID (G-…) in src/konfiguration.mjs eintragen', anker: '#1-besuche-erfassen-mess-id' },
  { id: 'verbindung', titel: 'Zahlen ins Dashboard holen', text: 'Dienstkonto anlegen und GA_PROPERTY_ID, GA_CLIENT_EMAIL, GA_PRIVATE_KEY bei Netlify eintragen', anker: '#2-kennzahlen-ins-dashboard-holen-dienstkonto' },
  { id: 'ads', titel: 'Google Ads verknüpfen', text: 'Optional: Google-Ads-Konto in Analytics verknüpfen', anker: '#3-google-ads-verknüpfen-optional' },
  { id: 'leads', titel: 'Anfragen messen', text: 'generate_lead als Schlüsselereignis, vier eigene Dimensionen anlegen', anker: '#4-anfragen-messen-weg-kanal-button' },
  { id: 'formular', titel: 'Kontaktformular einschalten', text: 'Bei Netlify „Form detection“ einschalten und Benachrichtigung einrichten', anker: '#5-kontaktformular-einschalten' },
];
---
<Dashboard titel="Performance" untertitel="Die echten Kennzahlen der Website aus Google Analytics: Wie viele Menschen kommen, was sehen sie sich an, und woher kommen sie? ">
  <details class="karte ga-einrichtung" id="ga-einrichtung" open>
    <summary><span class="ga-titel">Einrichtung Google Analytics</span> <span class="ga-stand" id="ga-stand">wird geprüft …</span></summary>
    <ol class="ga-schritte">
      {schritte.map((s, i) => (
        <li data-schritt={s.id} data-status={s.id === 'messid' ? (messId ? 'ok' : 'offen') : 'pruefen'}>
          <span class="ga-zeichen" aria-hidden="true">{i + 1}</span>
          <span class="ga-text"><strong>{s.titel}</strong><small>{s.text}</small></span>
          <span class="ga-status" data-status-text>{s.id === 'messid' ? (messId ? `erledigt (${messId})` : 'offen') : 'wird geprüft …'}</span>
          <a href={`${ANL}${s.anker}`}>Anleitung →</a>
        </li>
      ))}
    </ol>
    <p class="ga-fuss">Die Box prüft automatisch, was schon eingerichtet ist. <a href={ANL}>Ganze Anleitung „Google Analytics“ öffnen</a></p>
  </details>

  <div class="steuerung">
    <p id="quelle" class="quelle" aria-live="polite">Lade Kennzahlen …</p>
    <fieldset class="zeitraum">
      <legend class="visuell-versteckt">Zeitraum</legend>
      <label><input type="radio" name="tage" value="7" /> 7 Tage</label>
      <label><input type="radio" name="tage" value="30" checked /> 30 Tage</label>
      <label><input type="radio" name="tage" value="90" /> 90 Tage</label>
    </fieldset>
  </div>
  <p id="fehler" class="fehler" hidden></p>

  <div class="kacheln">
    <div class="karte kachel"><h2>Besucher</h2><p class="wert" id="wert-besucher">–</p></div>
    <div class="karte kachel"><h2>Seitenaufrufe</h2><p class="wert" id="wert-aufrufe">–</p></div>
  </div>

  <div class="karte verlauf">
    <h2>Besucher pro Tag</h2>
    <div class="diagramm" id="diagramm" role="img" aria-label="Liniendiagramm der Besucher pro Tag"></div>
  </div>

  <div class="tabellen">
    <div class="karte">
      <h2>Meistbesuchte Seiten</h2>
      <table><thead><tr><th scope="col">Seite</th><th scope="col" class="zahl">Aufrufe</th></tr></thead><tbody id="tabelle-seiten"></tbody></table>
    </div>
    <div class="karte">
      <h2>Herkunft der Besucher</h2>
      <table><thead><tr><th scope="col">Quelle</th><th scope="col" class="zahl">Besucher</th></tr></thead><tbody id="tabelle-herkunft"></tbody></table>
    </div>
  </div>

  <section class="kanal-auswertung" aria-labelledby="ka-titel">
    <h2 id="ka-titel">Kanal-Auswertung nach Monaten</h2>
    <p class="ka-text">Was die bezahlten Kanäle kosten und bringen: gesamt und je Kanal, Monat für Monat. Die drei farbigen Zeilen zeigen die Kosten je 1.000 Impressionen (CPM), je Klick (CPC) und je Abschluss (CPA). <strong>Klick auf einen Kanal</strong> zeigt dieselben Kennzahlen je Kampagne.</p>
    <p id="ka-quelle" class="quelle ka-quelle" aria-live="polite">Lade Kanal-Zahlen …</p>
    <p id="ka-fehler" class="fehler" hidden></p>
    <div class="karte ka-rahmen"><table class="ka-tabelle" id="ka-tabelle"></table></div>
    <p class="ka-legende">CTR = Klicks ÷ Impressionen · CVR = Abschlüsse ÷ Klicks · CPM = Kosten je 1.000 Impressionen · CPC = Kosten ÷ Klicks · CPA = Kosten ÷ Abschlüsse</p>
  </section>
  <script type="application/json" id="ka-daten" set:html={JSON.stringify(kanaele)}></script>
</Dashboard>

<script>
  type Kennzahlen = {
    quelle: 'analytics' | 'beispiel';
    besucher: number;
    seitenaufrufe: number;
    verlauf: { datum: string; besucher: number }[];
    seiten: { pfad: string; aufrufe: number }[];
    herkunft: { quelle: string; besucher: number }[];
  };

  const zahl = new Intl.NumberFormat('de-DE');
  const datumKurz = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: '2-digit' });
  const el = (id: string) => document.getElementById(id)!;

  async function beispieldaten(tage: number): Promise<Kennzahlen> {
    const d = await fetch('/daten/beispieldaten.json').then((r) => r.json());
    const werte: number[] = d.besucherProTag.slice(-tage);
    const heute = new Date();
    const verlauf = werte.map((besucher, i) => {
      const t = new Date(heute);
      t.setDate(heute.getDate() - (werte.length - 1 - i));
      return { datum: t.toISOString().slice(0, 10), besucher };
    });
    const besucher = werte.reduce((a, b) => a + b, 0);
    const seitenaufrufe = Math.round(besucher * d.seitenaufrufeJeBesucher);
    return {
      quelle: 'beispiel',
      besucher,
      seitenaufrufe,
      verlauf,
      seiten: d.seiten.map((s: any) => ({ pfad: s.pfad, aufrufe: Math.round(seitenaufrufe * s.anteil) })),
      herkunft: d.herkunft.map((h: any) => ({ quelle: h.quelle, besucher: Math.round(besucher * h.anteil) })),
    };
  }

  async function laden(tage: number): Promise<{ daten: Kennzahlen; fehler?: string }> {
    try {
      const antwort = await fetch(`/dashboard/api/kennzahlen?tage=${tage}`, { headers: { accept: 'application/json' }, credentials: 'same-origin' });
      const typ = antwort.headers.get('content-type') || '';
      if (typ.includes('application/json')) {
        const json = await antwort.json();
        if (antwort.ok && json.quelle === 'analytics') return { daten: json };
        // Funktion vorhanden, aber nicht eingerichtet oder fehlerhaft
        if (json.fehler && json.fehler !== 'nicht-eingerichtet') {
          return { daten: await beispieldaten(tage), fehler: json.meldung || json.fehler };
        }
      }
    } catch {
      /* Keine Serverfunktion erreichbar, z. B. lokal: Beispieldaten */
    }
    return { daten: await beispieldaten(tage) };
  }

  function tabelle(id: string, zeilen: [string, number][]) {
    const tbody = el(id);
    tbody.replaceChildren(
      ...zeilen.map(([name, wert]) => {
        const tr = document.createElement('tr');
        const a = document.createElement('td');
        a.textContent = name;
        const b = document.createElement('td');
        b.className = 'zahl';
        b.textContent = zahl.format(wert);
        tr.append(a, b);
        return tr;
      }),
    );
    if (!zeilen.length) tbody.innerHTML = '<tr><td colspan="2">Noch keine Daten</td></tr>';
  }

  function diagramm(verlauf: Kennzahlen['verlauf']) {
    const box = el('diagramm');
    // Das Diagramm wird in der tatsächlichen Breite gezeichnet, damit die Schrift nicht verzerrt
    const breite = Math.max(280, box.clientWidth || 800), hoehe = 260, rand = { l: 44, r: 12, o: 12, u: 28 };
    const max = Math.max(1, ...verlauf.map((p) => p.besucher));
    const oben = Math.ceil(max / 10) * 10;
    const x = (i: number) => rand.l + (verlauf.length <= 1 ? 0 : (i / (verlauf.length - 1)) * (breite - rand.l - rand.r));
    const y = (v: number) => hoehe - rand.u - (v / oben) * (hoehe - rand.o - rand.u);
    const linie = verlauf.map((p, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(p.besucher).toFixed(1)}`).join(' ');
    const flaeche = `${linie} L${x(verlauf.length - 1)} ${y(0)} L${x(0)} ${y(0)} Z`;
    const raster = [0, 0.5, 1].map((t) => {
      const v = Math.round(oben * t);
      return `<line x1="${rand.l}" x2="${breite - rand.r}" y1="${y(v)}" y2="${y(v)}" class="raster"/><text x="${rand.l - 8}" y="${y(v) + 4}" text-anchor="end" class="achse">${zahl.format(v)}</text>`;
    }).join('');
    const marken = [0, Math.floor((verlauf.length - 1) / 2), verlauf.length - 1].map((i) => {
      const anker = i === 0 ? 'start' : i === verlauf.length - 1 ? 'end' : 'middle';
      return `<text x="${x(i)}" y="${hoehe - 6}" text-anchor="${anker}" class="achse">${datumKurz.format(new Date(verlauf[i].datum))}</text>`;
    }).join('');
    box.innerHTML = `<svg viewBox="0 0 ${breite} ${hoehe}" aria-hidden="true">
      ${raster}
      <path d="${flaeche}" class="flaeche"/>
      <path d="${linie}" class="linie"/>
      ${marken}
      <line class="zeiger" x1="0" x2="0" y1="${rand.o}" y2="${hoehe - rand.u}" visibility="hidden"/>
    </svg><div class="tooltip" hidden></div>`;

    const svg = box.querySelector('svg')!;
    const zeiger = box.querySelector<SVGLineElement>('.zeiger')!;
    const tip = box.querySelector<HTMLDivElement>('.tooltip')!;
    svg.addEventListener('pointermove', (e) => {
      const r = svg.getBoundingClientRect();
      const px = ((e.clientX - r.left) / r.width) * breite;
      const i = Math.max(0, Math.min(verlauf.length - 1, Math.round(((px - rand.l) / (breite - rand.l - rand.r)) * (verlauf.length - 1))));
      zeiger.setAttribute('x1', String(x(i)));
      zeiger.setAttribute('x2', String(x(i)));
      zeiger.setAttribute('visibility', 'visible');
      tip.hidden = false;
      tip.textContent = `${datumKurz.format(new Date(verlauf[i].datum))}: ${zahl.format(verlauf[i].besucher)} Besucher`;
      tip.style.left = `${(x(i) / breite) * 100}%`;
    });
    svg.addEventListener('pointerleave', () => { zeiger.setAttribute('visibility', 'hidden'); tip.hidden = true; });
    box.setAttribute('aria-label', `Liniendiagramm: Besucher pro Tag, höchster Wert ${zahl.format(max)}`);
  }

  let letzterVerlauf: Kennzahlen['verlauf'] = [];
  let resizeTimer = 0;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => letzterVerlauf.length && diagramm(letzterVerlauf), 150);
  });

  async function anzeigen(tage: number) {
    el('quelle').textContent = 'Lade Kennzahlen …';
    const { daten, fehler } = await laden(tage);
    letzterVerlauf = daten.verlauf;
    el('quelle').innerHTML = daten.quelle === 'analytics'
      ? `<span class="marke live">Live</span> Daten aus Google Analytics, letzte ${tage} Tage`
      : `<span class="marke">Beispieldaten</span> Erfundene Werte, bis Google Analytics verbunden ist`;
    const f = el('fehler');
    f.hidden = !fehler;
    f.textContent = fehler ? `Die Verbindung zu Google Analytics hat nicht funktioniert: ${fehler}` : '';
    el('wert-besucher').textContent = zahl.format(daten.besucher);
    el('wert-aufrufe').textContent = zahl.format(daten.seitenaufrufe);
    diagramm(daten.verlauf);
    tabelle('tabelle-seiten', daten.seiten.map((s) => [s.pfad, s.aufrufe]));
    tabelle('tabelle-herkunft', daten.herkunft.map((h) => [h.quelle, h.besucher]));
  }

  document.querySelectorAll<HTMLInputElement>('input[name="tage"]').forEach((r) =>
    r.addEventListener('change', () => anzeigen(Number(r.value))),
  );
  anzeigen(30);
</script>

<script>
  // ---------- Einrichtung Google Analytics: Status je Schritt prüfen ----------
  const box = document.getElementById('ga-einrichtung') as HTMLDetailsElement;
  const setze = (id: string, status: 'ok' | 'offen' | 'unbekannt' | 'fehler', text: string) => {
    const li = box.querySelector<HTMLElement>(`[data-schritt="${id}"]`)!;
    li.dataset.status = status; li.querySelector('[data-status-text]')!.textContent = text;
  };
  const json = async (url: string) => {
    try { const r = await fetch(url, { credentials: 'same-origin', headers: { accept: 'application/json' } }); return (r.headers.get('content-type') || '').includes('json') ? { ok: r.ok, d: await r.json() } : null; }
    catch { return null; }
  };
  (async () => {
    const basis = await json('/dashboard/api/kennzahlen?tage=7');
    if (basis?.ok && basis.d.quelle === 'analytics') {
      setze('verbindung', 'ok', 'erledigt, verbunden');
      const [ads, leads] = await Promise.all([json('/dashboard/api/kennzahlen?bericht=kanaele&monate=6'), json('/dashboard/api/kennzahlen?bericht=leads&tage=30')]);
      if (ads?.ok) setze('ads', ads.d.leer ? 'offen' : 'ok', ads.d.leer ? 'offen: keine Google-Ads-Daten' : 'erledigt, Daten kommen an');
      else setze('ads', 'fehler', 'Fehler beim Abruf');
      if (leads?.ok) setze('leads', leads.d.dimensionenFehlen ? 'offen' : leads.d.gesamt ? 'ok' : 'unbekannt', leads.d.dimensionenFehlen ? 'offen: Dimensionen fehlen' : leads.d.gesamt ? `erledigt, ${leads.d.gesamt} Anfragen in 30 Tagen` : 'eingerichtet, noch keine Anfragen');
      else setze('leads', 'fehler', 'Fehler beim Abruf');
    } else {
      const grund = !basis ? 'offen (in der lokalen Vorschau nicht prüfbar)' : basis.d.fehler === 'nicht-eingerichtet' ? 'offen: Variablen fehlen bei Netlify' : `Fehler: ${basis.d.meldung || basis.d.fehler}`;
      setze('verbindung', basis && basis.d.fehler !== 'nicht-eingerichtet' ? 'fehler' : 'offen', grund);
      setze('ads', 'unbekannt', 'erst nach Schritt 2 prüfbar');
      setze('leads', 'unbekannt', 'erst nach Schritt 2 prüfbar');
    }
    setze('formular', 'unbekannt', 'bitte bei Netlify prüfen');
    const alle = Array.from(box.querySelectorAll<HTMLElement>('[data-schritt]'));
    const fertig = alle.filter((li) => li.dataset.status === 'ok').length;
    document.getElementById('ga-stand')!.textContent = `${fertig} von ${alle.length} erledigt`;
    // Ist die Verbindung da und nichts mehr offen, die Box zuklappen
    if (!alle.some((li) => li.dataset.status === 'offen' || li.dataset.status === 'fehler')) box.open = false;
  })();
</script>

<script>
  // ---------- Kanal-Auswertung nach Monaten ----------
  // Grundlage ist src/inhalte/performance-kanaele.json. Ist Google Analytics verbunden und
  // Google Ads dort verknüpft, ersetzt der Live-Bericht die Zahlen des Kanals "google-ads".
  type Reihen = { impressionen: number[]; klicks: number[]; kosten: number[]; abschluesse: number[] };
  type Kampagne = Reihen & { name: string };
  type Kanal = Reihen & { name: string; quelle?: string; logo?: string; farbe?: string; live?: boolean; kampagnen?: Kampagne[] };
  const offen = new Set<string>(); // aufgeklappte Kanäle
  const DATEI = JSON.parse(document.getElementById('ka-daten')!.textContent || '{}') as { beispiel: boolean; hinweis: string; monate: string[]; kanaele: Kanal[] };
  const FELDER = ['impressionen', 'klicks', 'kosten', 'abschluesse'] as const;
  const ganz = new Intl.NumberFormat('de-DE', { maximumFractionDigits: 0 });
  const euro = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' });
  const proz = new Intl.NumberFormat('de-DE', { style: 'percent', minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const teil = (a: number, b: number, f: Intl.NumberFormat) => (b ? f.format(a / b) : '–');
  type R = { i: number; k: number; e: number; a: number };
  const ZEILEN: { name: string; hilfe: string; abgeleitet?: boolean; wert: (r: R) => string }[] = [
    { name: 'Impressionen', hilfe: 'Wie oft die Anzeige gezeigt wurde', wert: (r) => ganz.format(r.i) },
    { name: 'Klicks', hilfe: 'Klicks auf die Anzeige', wert: (r) => ganz.format(r.k) },
    { name: 'CTR', hilfe: 'Klickrate: Klicks geteilt durch Impressionen', wert: (r) => teil(r.k, r.i, proz) },
    { name: 'Kosten', hilfe: 'Ausgaben im Monat', wert: (r) => euro.format(r.e) },
    { name: 'Abschlüsse', hilfe: 'Anfragen oder Käufe aus diesem Kanal', wert: (r) => ganz.format(r.a) },
    { name: 'CVR', hilfe: 'Abschlussrate: Abschlüsse geteilt durch Klicks', wert: (r) => teil(r.a, r.k, proz) },
    { name: 'CPM', hilfe: 'Kosten je 1.000 Impressionen', abgeleitet: true, wert: (r) => teil(r.e * 1000, r.i, euro) },
    { name: 'CPC', hilfe: 'Kosten je Klick', abgeleitet: true, wert: (r) => teil(r.e, r.k, euro) },
    { name: 'CPA', hilfe: 'Kosten je Abschluss', abgeleitet: true, wert: (r) => teil(r.e, r.a, euro) },
  ];
  const h = (tag: string, attr: Record<string, string> = {}, ...kinder: (Node | string)[]) => { const e = document.createElement(tag); for (const [k, v] of Object.entries(attr)) e.setAttribute(k, v); e.append(...kinder); return e; };
  const summe = (a: number[]) => a.reduce((s, x) => s + (x || 0), 0);

  // Zeilen mit den neun Kennzahlen für einen Block (Kanal, Gesamt oder Kampagne)
  function kennzahlZeilen(tbody: HTMLElement, monate: string[], b: Reihen) {
    for (const z of ZEILEN) {
      tbody.append(h('tr', z.abgeleitet ? { class: 'ka-abgeleitet' } : {},
        h('th', { scope: 'row', title: z.hilfe }, z.name),
        ...monate.map((_, i) => h('td', {}, z.wert({ i: b.impressionen[i] || 0, k: b.klicks[i] || 0, e: b.kosten[i] || 0, a: b.abschluesse[i] || 0 }))),
        h('td', { class: 'ka-summe' }, z.wert({ i: summe(b.impressionen), k: summe(b.klicks), e: summe(b.kosten), a: summe(b.abschluesse) }))));
    }
  }

  let letzteDaten: [string[], Kanal[]] | null = null;
  function zeichneKanaele(monate: string[], kanaele: Kanal[]) {
    letzteDaten = [monate, kanaele];
    const gesamt: Kanal = { name: 'Gesamt', impressionen: [], klicks: [], kosten: [], abschluesse: [] };
    for (const f of FELDER) gesamt[f] = monate.map((_, i) => kanaele.reduce((s, k) => s + (k[f][i] || 0), 0));
    const tabelle = document.getElementById('ka-tabelle')!;
    const bloecke: HTMLElement[] = [];
    [gesamt, ...kanaele].forEach((b, nr) => {
      const kampagnen = nr > 0 ? (b.kampagnen || []) : [];
      const auf = offen.has(b.name);
      const name = h('span', { class: 'ka-name' });
      if (nr > 0 && b.logo) name.append(h('img', { src: b.logo, alt: '', width: '20', height: '20' }));
      name.append(b.name);
      if (b.live) name.append(h('span', { class: 'ka-live' }, 'live'));
      let erste: HTMLElement = name;
      if (kampagnen.length) {
        // Klick auf den Kanal klappt die Kampagnen darunter auf
        const knopf = h('button', { type: 'button', class: 'ka-klapp', 'aria-expanded': String(auf), title: auf ? 'Kampagnen zuklappen' : 'Kampagnen aufklappen' },
          h('span', { class: 'ka-pfeil', 'aria-hidden': 'true' }, '▸'), name, h('span', { class: 'ka-anzahl' }, `${kampagnen.length} Kampagnen`));
        knopf.addEventListener('click', () => { if (offen.has(b.name)) offen.delete(b.name); else offen.add(b.name); zeichneKanaele(...letzteDaten!); (document.querySelector(`.ka-klapp[data-kanal="${CSS.escape(b.name)}"]`) as HTMLElement | null)?.focus(); });
        knopf.dataset.kanal = b.name;
        erste = knopf;
      }
      const kopf = h('tr', { class: 'ka-kopf' }, h('th', { scope: 'col' }, erste), ...monate.map((m) => h('th', { scope: 'col' }, m)), h('th', { scope: 'col' }, 'Summe'));
      const tbody = h('tbody', nr === 0 ? { class: 'ka-gesamt' } : b.farbe ? { style: `--ka-farbe:${b.farbe}` } : {}, kopf);
      kennzahlZeilen(tbody, monate, b);
      bloecke.push(tbody);
      if (auf) for (const c of kampagnen) {
        const kk = h('tbody', { class: 'ka-kampagne', style: b.farbe ? `--ka-farbe:${b.farbe}` : '' },
          h('tr', { class: 'ka-kopf ka-kopf-kampagne' }, h('th', { scope: 'col' }, h('span', { class: 'ka-name' }, h('span', { class: 'ka-einzug', 'aria-hidden': 'true' }, '↳'), c.name)), ...monate.map((m) => h('th', { scope: 'col' }, m)), h('th', { scope: 'col' }, 'Summe')));
        kennzahlZeilen(kk, monate, c);
        bloecke.push(kk);
      }
    });
    tabelle.replaceChildren(...bloecke);
  }

  // Zahlen eines Kanals aus der Datei auf andere Monatsspalten umlegen (fehlende Monate = 0)
  function umlegen(k: Kanal, monate: string[]): Kanal {
    const neu = { ...k };
    for (const f of FELDER) neu[f] = monate.map((m) => { const i = DATEI.monate.indexOf(m); return i === -1 ? 0 : k[f][i] || 0; });
    if (k.kampagnen) neu.kampagnen = k.kampagnen.map((c) => umlegen(c as Kanal, monate) as Kampagne);
    return neu;
  }
  const marke = (text: string, live = false) => h('span', { class: live ? 'marke live' : 'marke' }, text);

  (async () => {
    const quelle = document.getElementById('ka-quelle')!, fehler = document.getElementById('ka-fehler')!;
    const ausDatei = (grund: string) => {
      zeichneKanaele(DATEI.monate, DATEI.kanaele);
      quelle.replaceChildren(marke(DATEI.beispiel ? 'Beispieldaten' : 'Aus Datei'), `${grund} Zahlen aus src/inhalte/performance-kanaele.json.`);
    };
    try {
      const r = await fetch(`/dashboard/api/kennzahlen?bericht=kanaele&monate=${DATEI.monate.length > 6 ? 12 : 6}`, { headers: { accept: 'application/json' }, credentials: 'same-origin' });
      const json = (r.headers.get('content-type') || '').includes('application/json') ? await r.json() : null;
      if (r.ok && json?.quelle === 'analytics' && !json.leer) {
        const kanaele = DATEI.kanaele.map((k) => (k.quelle === 'google-ads' ? { ...k, ...json.googleAds, live: true } : umlegen(k, json.monate)));
        if (!kanaele.some((k) => k.live)) kanaele.unshift({ name: 'Google Ads', logo: '/logos/googleads.svg', farbe: '#2f7d32', ...json.googleAds, live: true });
        zeichneKanaele(json.monate, kanaele);
        const rest = kanaele.filter((k) => !k.live).map((k) => k.name);
        quelle.replaceChildren(marke('Live', true), `Google Ads kommt aus Google Analytics (Abschlüsse = Schlüsselereignisse aus „google / cpc“).${rest.length ? ` ${rest.join(', ')}: aus der Datei.` : ''}`);
        return;
      }
      if (json?.leer) return ausDatei('Google Analytics ist verbunden, liefert aber keine Google-Ads-Zahlen: Bitte in Analytics unter Verwaltung → Produktverknüpfungen das Google-Ads-Konto verknüpfen.');
      if (json?.fehler && json.fehler !== 'nicht-eingerichtet') { fehler.hidden = false; fehler.textContent = `Google Analytics: ${json.meldung || json.fehler}`; }
    } catch { /* keine Serverfunktion erreichbar, z. B. lokal */ }
    ausDatei('Google Analytics ist noch nicht verbunden.');
  })();
</script>

