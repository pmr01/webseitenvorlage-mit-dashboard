---
// Reiter Performance (6. P): die Kennzahlen der Website aus Google Analytics.
// Die Werte kommen von der Serverfunktion netlify/functions/kennzahlen.mjs (Adresse /dashboard/api/kennzahlen).
// Ist sie nicht eingerichtet, zeigt die Seite Beispieldaten aus public/daten/beispieldaten.json.
import Dashboard from '../../layouts/Dashboard.astro';
---
<Dashboard titel="Performance" untertitel="Die echten Kennzahlen der Website aus Google Analytics: Wie viele Menschen kommen, was sehen sie sich an, und woher kommen sie? Die Einrichtung steht in den Anleitungen unter „Dashboard und Google Analytics“.">
  <div class="steuerung">
    <p id="quelle" class="quelle" aria-live="polite">Lade Kennzahlen …</p>
    <fieldset class="zeitraum">
      <legend class="visuell-versteckt">Zeitraum</legend>
      <label><input type="radio" name="tage" value="7" /> 7 Tage</label>
      <label><input type="radio" name="tage" value="30" checked /> 30 Tage</label>
      <label><input type="radio" name="tage" value="90" /> 90 Tage</label>
    </fieldset>
  </div>
  <p id="fehler" class="fehler" hidden></p>

  <div class="kacheln">
    <div class="karte kachel"><h2>Besucher</h2><p class="wert" id="wert-besucher">–</p></div>
    <div class="karte kachel"><h2>Seitenaufrufe</h2><p class="wert" id="wert-aufrufe">–</p></div>
  </div>

  <div class="karte verlauf">
    <h2>Besucher pro Tag</h2>
    <div class="diagramm" id="diagramm" role="img" aria-label="Liniendiagramm der Besucher pro Tag"></div>
  </div>

  <div class="tabellen">
    <div class="karte">
      <h2>Meistbesuchte Seiten</h2>
      <table><thead><tr><th scope="col">Seite</th><th scope="col" class="zahl">Aufrufe</th></tr></thead><tbody id="tabelle-seiten"></tbody></table>
    </div>
    <div class="karte">
      <h2>Herkunft der Besucher</h2>
      <table><thead><tr><th scope="col">Quelle</th><th scope="col" class="zahl">Besucher</th></tr></thead><tbody id="tabelle-herkunft"></tbody></table>
    </div>
  </div>
</Dashboard>

<script>
  type Kennzahlen = {
    quelle: 'analytics' | 'beispiel';
    besucher: number;
    seitenaufrufe: number;
    verlauf: { datum: string; besucher: number }[];
    seiten: { pfad: string; aufrufe: number }[];
    herkunft: { quelle: string; besucher: number }[];
  };

  const zahl = new Intl.NumberFormat('de-DE');
  const datumKurz = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: '2-digit' });
  const el = (id: string) => document.getElementById(id)!;

  async function beispieldaten(tage: number): Promise<Kennzahlen> {
    const d = await fetch('/daten/beispieldaten.json').then((r) => r.json());
    const werte: number[] = d.besucherProTag.slice(-tage);
    const heute = new Date();
    const verlauf = werte.map((besucher, i) => {
      const t = new Date(heute);
      t.setDate(heute.getDate() - (werte.length - 1 - i));
      return { datum: t.toISOString().slice(0, 10), besucher };
    });
    const besucher = werte.reduce((a, b) => a + b, 0);
    const seitenaufrufe = Math.round(besucher * d.seitenaufrufeJeBesucher);
    return {
      quelle: 'beispiel',
      besucher,
      seitenaufrufe,
      verlauf,
      seiten: d.seiten.map((s: any) => ({ pfad: s.pfad, aufrufe: Math.round(seitenaufrufe * s.anteil) })),
      herkunft: d.herkunft.map((h: any) => ({ quelle: h.quelle, besucher: Math.round(besucher * h.anteil) })),
    };
  }

  async function laden(tage: number): Promise<{ daten: Kennzahlen; fehler?: string }> {
    try {
      const antwort = await fetch(`/dashboard/api/kennzahlen?tage=${tage}`, { headers: { accept: 'application/json' }, credentials: 'same-origin' });
      const typ = antwort.headers.get('content-type') || '';
      if (typ.includes('application/json')) {
        const json = await antwort.json();
        if (antwort.ok && json.quelle === 'analytics') return { daten: json };
        // Funktion vorhanden, aber nicht eingerichtet oder fehlerhaft
        if (json.fehler && json.fehler !== 'nicht-eingerichtet') {
          return { daten: await beispieldaten(tage), fehler: json.meldung || json.fehler };
        }
      }
    } catch {
      /* Keine Serverfunktion erreichbar, z. B. lokal: Beispieldaten */
    }
    return { daten: await beispieldaten(tage) };
  }

  function tabelle(id: string, zeilen: [string, number][]) {
    const tbody = el(id);
    tbody.replaceChildren(
      ...zeilen.map(([name, wert]) => {
        const tr = document.createElement('tr');
        const a = document.createElement('td');
        a.textContent = name;
        const b = document.createElement('td');
        b.className = 'zahl';
        b.textContent = zahl.format(wert);
        tr.append(a, b);
        return tr;
      }),
    );
    if (!zeilen.length) tbody.innerHTML = '<tr><td colspan="2">Noch keine Daten</td></tr>';
  }

  function diagramm(verlauf: Kennzahlen['verlauf']) {
    const box = el('diagramm');
    // Das Diagramm wird in der tatsächlichen Breite gezeichnet, damit die Schrift nicht verzerrt
    const breite = Math.max(280, box.clientWidth || 800), hoehe = 260, rand = { l: 44, r: 12, o: 12, u: 28 };
    const max = Math.max(1, ...verlauf.map((p) => p.besucher));
    const oben = Math.ceil(max / 10) * 10;
    const x = (i: number) => rand.l + (verlauf.length <= 1 ? 0 : (i / (verlauf.length - 1)) * (breite - rand.l - rand.r));
    const y = (v: number) => hoehe - rand.u - (v / oben) * (hoehe - rand.o - rand.u);
    const linie = verlauf.map((p, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(p.besucher).toFixed(1)}`).join(' ');
    const flaeche = `${linie} L${x(verlauf.length - 1)} ${y(0)} L${x(0)} ${y(0)} Z`;
    const raster = [0, 0.5, 1].map((t) => {
      const v = Math.round(oben * t);
      return `<line x1="${rand.l}" x2="${breite - rand.r}" y1="${y(v)}" y2="${y(v)}" class="raster"/><text x="${rand.l - 8}" y="${y(v) + 4}" text-anchor="end" class="achse">${zahl.format(v)}</text>`;
    }).join('');
    const marken = [0, Math.floor((verlauf.length - 1) / 2), verlauf.length - 1].map((i) => {
      const anker = i === 0 ? 'start' : i === verlauf.length - 1 ? 'end' : 'middle';
      return `<text x="${x(i)}" y="${hoehe - 6}" text-anchor="${anker}" class="achse">${datumKurz.format(new Date(verlauf[i].datum))}</text>`;
    }).join('');
    box.innerHTML = `<svg viewBox="0 0 ${breite} ${hoehe}" aria-hidden="true">
      ${raster}
      <path d="${flaeche}" class="flaeche"/>
      <path d="${linie}" class="linie"/>
      ${marken}
      <line class="zeiger" x1="0" x2="0" y1="${rand.o}" y2="${hoehe - rand.u}" visibility="hidden"/>
    </svg><div class="tooltip" hidden></div>`;

    const svg = box.querySelector('svg')!;
    const zeiger = box.querySelector<SVGLineElement>('.zeiger')!;
    const tip = box.querySelector<HTMLDivElement>('.tooltip')!;
    svg.addEventListener('pointermove', (e) => {
      const r = svg.getBoundingClientRect();
      const px = ((e.clientX - r.left) / r.width) * breite;
      const i = Math.max(0, Math.min(verlauf.length - 1, Math.round(((px - rand.l) / (breite - rand.l - rand.r)) * (verlauf.length - 1))));
      zeiger.setAttribute('x1', String(x(i)));
      zeiger.setAttribute('x2', String(x(i)));
      zeiger.setAttribute('visibility', 'visible');
      tip.hidden = false;
      tip.textContent = `${datumKurz.format(new Date(verlauf[i].datum))}: ${zahl.format(verlauf[i].besucher)} Besucher`;
      tip.style.left = `${(x(i) / breite) * 100}%`;
    });
    svg.addEventListener('pointerleave', () => { zeiger.setAttribute('visibility', 'hidden'); tip.hidden = true; });
    box.setAttribute('aria-label', `Liniendiagramm: Besucher pro Tag, höchster Wert ${zahl.format(max)}`);
  }

  let letzterVerlauf: Kennzahlen['verlauf'] = [];
  let resizeTimer = 0;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => letzterVerlauf.length && diagramm(letzterVerlauf), 150);
  });

  async function anzeigen(tage: number) {
    el('quelle').textContent = 'Lade Kennzahlen …';
    const { daten, fehler } = await laden(tage);
    letzterVerlauf = daten.verlauf;
    el('quelle').innerHTML = daten.quelle === 'analytics'
      ? `<span class="marke live">Live</span> Daten aus Google Analytics, letzte ${tage} Tage`
      : `<span class="marke">Beispieldaten</span> Erfundene Werte, bis Google Analytics verbunden ist`;
    const f = el('fehler');
    f.hidden = !fehler;
    f.textContent = fehler ? `Die Verbindung zu Google Analytics hat nicht funktioniert: ${fehler}` : '';
    el('wert-besucher').textContent = zahl.format(daten.besucher);
    el('wert-aufrufe').textContent = zahl.format(daten.seitenaufrufe);
    diagramm(daten.verlauf);
    tabelle('tabelle-seiten', daten.seiten.map((s) => [s.pfad, s.aufrufe]));
    tabelle('tabelle-herkunft', daten.herkunft.map((h) => [h.quelle, h.besucher]));
  }

  document.querySelectorAll<HTMLInputElement>('input[name="tage"]').forEach((r) =>
    r.addEventListener('change', () => anzeigen(Number(r.value))),
  );
  anzeigen(30);
</script>

<style>
  .steuerung { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 16px; }
  .quelle { margin: 0; color: #4c595f; }
  .quelle :global(.marke) { display: inline-block; padding: 2px 10px; border-radius: 999px; background: #fff4dd; border: 1px solid #f0d199; font-weight: 700; font-size: .85rem; margin-right: 6px; }
  .quelle :global(.marke.live) { background: #e3f4e8; border-color: #9fd3ad; }
  .zeitraum { display: flex; border: 1px solid #cfd8dc; border-radius: 8px; padding: 0; margin: 0; overflow: hidden; background: #fff; }
  .zeitraum label { padding: 6px 14px; cursor: pointer; font-weight: 600; font-size: .92rem; }
  .zeitraum label + label { border-left: 1px solid #cfd8dc; }
  .zeitraum input { position: absolute; opacity: 0; pointer-events: none; }
  .zeitraum label:has(input:checked) { background: var(--haupt); color: #fff; }
  .zeitraum label:has(input:focus-visible) { outline: 3px solid var(--akzent); outline-offset: -3px; }
  .fehler { background: #fdecec; border: 1px solid #f1b5b5; border-radius: 10px; padding: 10px 14px; }

  .kacheln { display: grid; gap: 16px; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-bottom: 16px; }
  .kachel h2 { font-size: .95rem; color: #5a676d; margin-bottom: .2em; }
  .wert { font-size: clamp(1.8rem, 5vw, 2.6rem); font-weight: 700; margin: 0; font-variant-numeric: tabular-nums; }

  .verlauf { margin-bottom: 16px; }
  .diagramm { position: relative; height: 260px; }
  .diagramm :global(svg) { width: 100%; height: 100%; overflow: visible; }
  .diagramm :global(.raster) { stroke: #e3e8ea; stroke-width: 1; }
  .diagramm :global(.achse) { fill: #6b777c; font-size: 12px; }
  .diagramm :global(.linie) { fill: none; stroke: var(--haupt); stroke-width: 2.5; stroke-linejoin: round; }
  .diagramm :global(.flaeche) { fill: color-mix(in srgb, var(--haupt) 12%, transparent); }
  .diagramm :global(.zeiger) { stroke: #9aa6ab; stroke-dasharray: 3 3; }
  .diagramm :global(.tooltip) { position: absolute; top: 0; transform: translateX(-50%); background: var(--text); color: #fff; font-size: .82rem; padding: 4px 8px; border-radius: 6px; white-space: nowrap; pointer-events: none; }

  .tabellen { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); }
  table { width: 100%; border-collapse: collapse; font-size: .95rem; }
  th { text-align: left; color: #5a676d; font-weight: 600; border-bottom: 1px solid #dde3e6; padding: 6px 0; }
  td { padding: 8px 0; border-bottom: 1px solid #eef1f2; overflow-wrap: anywhere; }
  .zahl { text-align: right; font-variant-numeric: tabular-nums; padding-left: 12px; }
  @media (max-width: 480px) { .kacheln { grid-template-columns: 1fr; } }
</style>
