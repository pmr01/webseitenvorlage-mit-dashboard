---
// Reiter Promotion → Kanäle & Budget.
// Zeigt die gängigsten Marketing-Kanäle nach Kategorien, EU-relevante Affiliate-Netzwerke
// mit Filter nach Produktart und eine Budgetplanung (Testzeitraum, Monat oder Jahr).
// Inhalte ändern in src/inhalte/kanaele.json. Die Budgetplanung speichert nur der Browser.
import Dashboard from '../../../layouts/Dashboard.astro';
import Unterseiten from '../../../components/Unterseiten.astro';
import { PROMOTION_SEITEN } from '../../../components/promotion-seiten.mjs';
import daten from '../../../inhalte/kanaele.json';
import Reiter from '../../../components/Reiter.astro';
import Logo from '../../../components/Logo.astro';
const host = (url: string) => { try { return new URL(url).host.replace(/^www\./, ''); } catch { return url; } };
---
<Dashboard titel="Promotion" untertitel="Über welche Kanäle finden Kunden zu Ihnen, und wie viel Budget setzen Sie wo ein?">
  <Unterseiten seiten={PROMOTION_SEITEN} />

  <Reiter beschriftung="Kanäle" eintraege={[
    ...daten.kategorien.map((k) => ({ id: k.name.toLowerCase().replace(/\s+/g, '-'), name: k.name })),
    { id: 'affiliate', name: 'Affiliate-Marketing' },
    { id: 'budget', name: 'Budgetplanung' },
  ]} />

  {daten.kategorien.map((k) => (
    <section class="kategorie" id={k.name.toLowerCase().replace(/\s+/g, '-')}>
      <h2>{k.name}</h2>
      <p class="beschreibung">{k.beschreibung}</p>
      <ul class="kanaele">
        {k.kanaele.map((kanal) => (
          <li class="karte">
            <h3 class="mit-logo"><Logo name={kanal.name} logo={kanal.logo} groesse={32} />{kanal.name}</h3>
            <p>{kanal.zweck}</p>
            <ul class="werkzeuge">
              {kanal.werkzeuge.map((w) => <li><a href={w.link} target="_blank" rel="noopener" class="mit-logo klein"><Logo name={w.name} logo={w.logo} groesse={18} />{w.name} <span aria-hidden="true">↗</span></a></li>)}
            </ul>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="kategorie" id="affiliate">
    <h2>Affiliate-Marketing</h2>
    <p class="beschreibung">{daten.affiliate.beschreibung}</p>
    <fieldset class="filter">
      <legend>Produktart</legend>
      <label><input type="radio" name="produktart" value="alle" checked /> Alle</label>
      {daten.affiliate.produktarten.map((p) => <label><input type="radio" name="produktart" value={p} /> {p}</label>)}
    </fieldset>
    <p class="treffer" id="aff-treffer" aria-live="polite"></p>
    <ul class="netzwerke">
      {daten.affiliate.netzwerke.map((n) => (
        <li class="karte" data-produktarten={JSON.stringify(n.produktarten)}>
          <div class="netz-kopf"><h3 class="mit-logo"><Logo name={n.name} logo={n.logo} groesse={32} />{n.name}</h3><span class="sitz">{n.sitz}</span></div>
          <p>{n.schwerpunkt}</p>
          <ul class="tags">{n.produktarten.map((p) => <li>{p}</li>)}</ul>
          <a href={n.link} target="_blank" rel="noopener">{host(n.link)} <span aria-hidden="true">↗</span></a>
        </li>
      ))}
    </ul>
    <p class="stand">Stand {daten.stand}. {daten.hinweis}</p>
  </section>

  <section class="kategorie" id="budget" aria-labelledby="budget-titel">
    <h2 id="budget-titel">Budgetplanung</h2>
    <p class="beschreibung">Planen Sie, wie viel Sie pro Monat in welchen Kanal stecken. Starten Sie am besten mit einem Testzeitraum von ein bis zwei Monaten und verteilen Sie das Budget danach auf das Jahr.</p>

    <div class="karte budget">
      <div class="b-steuerung">
        <div class="b-modus" role="tablist" aria-label="Zeitraum">
          <button type="button" role="tab" data-modus="test" aria-selected="true">Testzeitraum</button>
          <button type="button" role="tab" data-modus="monat" aria-selected="false">Monat</button>
          <button type="button" role="tab" data-modus="jahr" aria-selected="false">Jahr</button>
        </div>
        <label class="b-feld" id="b-feld-dauer">Dauer
          <select id="b-dauer"><option value="1">1 Monat</option><option value="2" selected>2 Monate</option></select>
        </label>
        <label class="b-feld" id="b-feld-start">Start
          <input type="month" id="b-start" />
        </label>
        <label class="b-feld" id="b-feld-jahr" hidden>Jahr
          <input type="number" id="b-jahr" min="2020" max="2100" step="1" />
        </label>
      </div>

      <div class="b-tabelle-rahmen">
        <table class="b-tabelle" id="b-tabelle"></table>
      </div>

      <div class="b-aktionen">
        <button type="button" class="pm-btn" id="b-position">+ Position</button>
        <button type="button" class="pm-btn" id="b-gleich" hidden>Ersten Monat in alle Monate übernehmen</button>
        <span class="b-luecke"></span>
        <button type="button" class="pm-link" id="b-csv">Als Tabelle (CSV) herunterladen</button>
        <button type="button" class="pm-link" id="b-leeren">Alle Beträge leeren</button>
      </div>

      <div class="b-auswertung">
        <div class="b-summe"><span>Gesamtbudget</span><strong id="b-gesamt">0 €</strong><small id="b-schnitt"></small></div>
        <div class="b-anteile" id="b-anteile" aria-label="Anteil der Kanäle am Budget"></div>
      </div>
      <p class="stand">Beträge in Euro, netto. Die Planung speichert nur Ihr Browser auf diesem Gerät; sichern Sie sie über den CSV-Download.</p>
    </div>
  </section>
</Dashboard>

<script>
  // ---------- Affiliate-Filter ----------
  const karten = Array.from(document.querySelectorAll<HTMLElement>('.netzwerke > li'));
  function filtern(art: string) {
    let n = 0;
    karten.forEach((k) => {
      const passt = art === 'alle' || (JSON.parse(k.dataset.produktarten || '[]') as string[]).includes(art);
      k.hidden = !passt;
      if (passt) n++;
    });
    document.getElementById('aff-treffer')!.textContent = art === 'alle' ? `${n} Netzwerke` : `${n} Netzwerke für „${art}“`;
  }
  document.querySelectorAll<HTMLInputElement>('input[name="produktart"]').forEach((r) => r.addEventListener('change', () => filtern(r.value)));
  filtern('alle');

  // ---------- Budgetplanung ----------
  type Modus = 'test' | 'monat' | 'jahr';
  type Zeile = { id: string; name: string; werte: Record<Modus, number[]> };
  type Plan = { modus: Modus; dauer: number; start: string; jahr: number; zeilen: Zeile[] };

  const SPEICHER = 'kanaele-budget';
  const euro = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
  const monatName = new Intl.DateTimeFormat('de-DE', { month: 'short', year: '2-digit' });
  // Logos für Budget-Positionen anhand des Namens
  const LOGOS: [RegExp, string][] = [[/google/i, '/logos/googleads.svg'], [/meta|facebook|instagram/i, '/logos/meta.svg'], [/tiktok/i, '/logos/tiktok.svg'], [/youtube/i, '/logos/youtube.svg']];
  const logoFuer = (name: string) => LOGOS.find(([m]) => m.test(name))?.[1] ?? '';
  const FARBEN = ['#1f4e5f', '#e0a458', '#3d8b5a', '#2f6fa6', '#b04646', '#7a5ea8', '#5b7f8c', '#c27c2c'];
  const leer = (): Record<Modus, number[]> => ({ test: [0, 0], monat: [0], jahr: Array(12).fill(0) });
  const heute = new Date();
  const startMonat = `${heute.getFullYear()}-${String(heute.getMonth() + 2 > 12 ? 1 : heute.getMonth() + 2).padStart(2, '0')}`;

  function standardPlan(): Plan {
    const namen = ['Google Ads (Suche)', 'Microsoft Advertising (Bing, Yahoo)', 'Meta Ads (Facebook, Instagram)', 'TikTok Ads', 'YouTube-Werbung', 'Affiliate-Provisionen'];
    return {
      modus: 'test', dauer: 2, start: heute.getMonth() === 11 ? `${heute.getFullYear() + 1}-01` : startMonat, jahr: heute.getFullYear() + (heute.getMonth() >= 9 ? 1 : 0),
      zeilen: namen.map((name, i) => ({ id: 'z' + i, name, werte: leer() })),
    };
  }
  function laden(): Plan {
    try {
      const p = JSON.parse(localStorage.getItem(SPEICHER) || 'null');
      if (p && Array.isArray(p.zeilen)) {
        const basis = standardPlan();
        return {
          modus: ['test', 'monat', 'jahr'].includes(p.modus) ? p.modus : 'test',
          dauer: p.dauer === 1 ? 1 : 2,
          start: /^\d{4}-\d{2}$/.test(p.start) ? p.start : basis.start,
          jahr: Number.isInteger(p.jahr) ? p.jahr : basis.jahr,
          zeilen: p.zeilen.map((z: any, i: number) => ({
            id: String(z.id || 'z' + i), name: String(z.name || 'Position').slice(0, 80),
            werte: {
              test: [0, 1].map((m) => Math.max(0, Number(z.werte?.test?.[m]) || 0)),
              monat: [Math.max(0, Number(z.werte?.monat?.[0]) || 0)],
              jahr: Array.from({ length: 12 }, (_, m) => Math.max(0, Number(z.werte?.jahr?.[m]) || 0)),
            },
          })),
        };
      }
    } catch { /* kein Speicher */ }
    return standardPlan();
  }
  let plan = laden();
  const speichern = () => { try { localStorage.setItem(SPEICHER, JSON.stringify(plan)); } catch { /* ohne Speicher */ } };

  function spalten(): string[] {
    if (plan.modus === 'jahr') return Array.from({ length: 12 }, (_, m) => monatName.format(new Date(plan.jahr, m, 1)));
    const [j, m] = plan.start.split('-').map(Number);
    const anzahl = plan.modus === 'test' ? plan.dauer : 1;
    return Array.from({ length: anzahl }, (_, i) => monatName.format(new Date(j, m - 1 + i, 1)));
  }
  const werteVon = (z: Zeile) => z.werte[plan.modus].slice(0, spalten().length);
  const summe = (a: number[]) => a.reduce((x, y) => x + y, 0);

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, attrs: Record<string, any> = {}, ...kinder: (Node | string | null)[]) {
    const e = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) { if (v !== undefined && v !== null && v !== false) e.setAttribute(k, v === true ? '' : String(v)); }
    for (const k of kinder) if (k !== null) e.append(k);
    return e;
  }

  function zeichnen() {
    document.querySelectorAll<HTMLButtonElement>('[data-modus]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.modus === plan.modus)));
    (document.getElementById('b-feld-dauer') as HTMLElement).hidden = plan.modus !== 'test';
    (document.getElementById('b-feld-start') as HTMLElement).hidden = plan.modus === 'jahr';
    (document.getElementById('b-feld-jahr') as HTMLElement).hidden = plan.modus !== 'jahr';
    (document.getElementById('b-gleich') as HTMLElement).hidden = plan.modus === 'monat' || (plan.modus === 'test' && plan.dauer === 1);
    (document.getElementById('b-dauer') as HTMLSelectElement).value = String(plan.dauer);
    (document.getElementById('b-start') as HTMLInputElement).value = plan.start;
    (document.getElementById('b-jahr') as HTMLInputElement).value = String(plan.jahr);

    const kopf = spalten();
    const tabelle = document.getElementById('b-tabelle')!;
    const thead = el('thead', {}, el('tr', {}, el('th', { scope: 'col' }, 'Kanal'), ...kopf.map((k) => el('th', { scope: 'col', class: 'zahl' }, k)), el('th', { scope: 'col', class: 'zahl' }, 'Summe'), el('th', { scope: 'col' }, el('span', { class: 'visuell-versteckt' }, 'Entfernen'))));
    const tbody = el('tbody');
    plan.zeilen.forEach((z, zi) => {
      const name = el('input', { type: 'text', value: z.name, maxlength: 80, 'aria-label': 'Name des Kanals', class: 'b-name' }) as HTMLInputElement;
      name.addEventListener('change', () => { z.name = name.value.trim() || 'Position'; speichern(); auswerten(); });
      const zellen = kopf.map((monat, mi) => {
        const feld = el('input', { type: 'number', min: 0, step: 50, inputmode: 'numeric', value: z.werte[plan.modus][mi] || '', placeholder: '0', 'aria-label': `${z.name}, ${monat}, Euro` }) as HTMLInputElement;
        feld.addEventListener('input', () => { z.werte[plan.modus][mi] = Math.max(0, Number(feld.value) || 0); speichern(); auswerten(); });
        return el('td', { class: 'zahl' }, feld);
      });
      const weg = el('button', { type: 'button', class: 'b-weg', 'aria-label': `${z.name} entfernen`, title: 'Entfernen' }, '×');
      weg.addEventListener('click', () => { if (confirm(`„${z.name}“ aus der Planung entfernen?`)) { plan.zeilen.splice(zi, 1); speichern(); zeichnen(); } });
      const logo = logoFuer(z.name);
      tbody.append(el('tr', {}, el('th', { scope: 'row' }, el('span', { class: 'b-punkt', style: `background:${FARBEN[zi % FARBEN.length]}` }), logo ? el('img', { src: logo, alt: '', width: 20, height: 20, class: 'b-logo' }) : el('span', { class: 'b-logo leer' }), name), ...zellen, el('td', { class: 'zahl b-zeilensumme', 'data-zeile': z.id }), el('td', {}, weg)));
    });
    const tfoot = el('tfoot', {}, el('tr', {}, el('th', { scope: 'row' }, 'Summe pro Monat'), ...kopf.map((_, mi) => el('td', { class: 'zahl', 'data-spalte': mi })), el('td', { class: 'zahl', id: 'b-ecke' }), el('td')));
    tabelle.replaceChildren(thead, tbody, tfoot);
    auswerten();
  }

  function auswerten() {
    const kopf = spalten();
    plan.zeilen.forEach((z) => { const zelle = document.querySelector(`[data-zeile="${z.id}"]`); if (zelle) zelle.textContent = euro.format(summe(werteVon(z))); });
    kopf.forEach((_, mi) => { const zelle = document.querySelector(`[data-spalte="${mi}"]`); if (zelle) zelle.textContent = euro.format(summe(plan.zeilen.map((z) => z.werte[plan.modus][mi] || 0))); });
    const gesamt = summe(plan.zeilen.map((z) => summe(werteVon(z))));
    const ecke = document.getElementById('b-ecke'); if (ecke) ecke.textContent = euro.format(gesamt);
    document.getElementById('b-gesamt')!.textContent = euro.format(gesamt);
    document.getElementById('b-schnitt')!.textContent = kopf.length > 1 ? `Ø ${euro.format(gesamt / kopf.length)} pro Monat über ${kopf.length} Monate` : 'für einen Monat';

    const anteile = document.getElementById('b-anteile')!;
    if (!gesamt) { anteile.replaceChildren(el('p', { class: 'stand' }, 'Tragen Sie Beträge ein, um die Verteilung zu sehen.')); return; }
    const balken = el('div', { class: 'b-balken' });
    const legende = el('ul', { class: 'b-legende' });
    plan.zeilen.forEach((z, zi) => {
      const s = summe(werteVon(z));
      if (!s) return;
      const anteil = (s / gesamt) * 100;
      balken.append(el('span', { style: `width:${anteil}%;background:${FARBEN[zi % FARBEN.length]}`, title: `${z.name}: ${euro.format(s)}` }));
      legende.append(el('li', {}, el('span', { class: 'b-punkt', style: `background:${FARBEN[zi % FARBEN.length]}` }), `${z.name}: ${euro.format(s)} (${anteil.toFixed(0)} %)`));
    });
    anteile.replaceChildren(balken, legende);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-modus]').forEach((b) => b.addEventListener('click', () => { plan.modus = b.dataset.modus as Modus; speichern(); zeichnen(); }));
  document.getElementById('b-dauer')!.addEventListener('change', (e) => { plan.dauer = Number((e.target as HTMLSelectElement).value) === 1 ? 1 : 2; speichern(); zeichnen(); });
  document.getElementById('b-start')!.addEventListener('change', (e) => { const v = (e.target as HTMLInputElement).value; if (/^\d{4}-\d{2}$/.test(v)) { plan.start = v; speichern(); zeichnen(); } });
  document.getElementById('b-jahr')!.addEventListener('change', (e) => { const v = Number((e.target as HTMLInputElement).value); if (v >= 2020 && v <= 2100) { plan.jahr = v; speichern(); zeichnen(); } });
  document.getElementById('b-position')!.addEventListener('click', () => {
    plan.zeilen.push({ id: 'z' + Date.now().toString(36), name: 'Neue Position', werte: leer() }); speichern(); zeichnen();
    const namen = document.querySelectorAll<HTMLInputElement>('.b-name'); namen[namen.length - 1]?.select();
  });
  document.getElementById('b-gleich')!.addEventListener('click', () => {
    const n = spalten().length;
    plan.zeilen.forEach((z) => { for (let i = 1; i < n; i++) z.werte[plan.modus][i] = z.werte[plan.modus][0]; });
    speichern(); zeichnen();
  });
  document.getElementById('b-leeren')!.addEventListener('click', () => {
    if (!confirm('Alle Beträge in diesem Zeitraum auf 0 setzen?')) return;
    plan.zeilen.forEach((z) => { z.werte[plan.modus] = leer()[plan.modus]; }); speichern(); zeichnen();
  });
  document.getElementById('b-csv')!.addEventListener('click', () => {
    const kopf = spalten();
    const zelle = (v: string | number) => `"${String(v).replace(/"/g, '""')}"`;
    const zeilen = [
      ['Kanal', ...kopf, 'Summe'],
      ...plan.zeilen.map((z) => [z.name, ...werteVon(z), summe(werteVon(z))]),
      ['Summe pro Monat', ...kopf.map((_, mi) => summe(plan.zeilen.map((z) => z.werte[plan.modus][mi] || 0))), summe(plan.zeilen.map((z) => summe(werteVon(z))))],
    ];
    const csv = '﻿' + zeilen.map((r) => r.map(zelle).join(';')).join('\r\n');
    const a = el('a', { href: URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' })), download: `budgetplanung-${plan.modus}.csv` }) as HTMLAnchorElement;
    document.body.append(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  });

  zeichnen();
</script>

<style>
  .sprung { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
  .sprung a { padding: 5px 11px; border-radius: 999px; background: #fff; border: 1px solid #dde3e6; text-decoration: none; font-weight: 600; font-size: .85rem; }
  .kategorie { margin-top: 0; }
  .kategorie > h2 { font-size: 1.3rem; margin-bottom: .3em; }
  .beschreibung { color: #4c595f; max-width: 80ch; }
  .kanaele, .netzwerke { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); }
  .kanaele > li, .netzwerke > li { display: flex; flex-direction: column; }
  .kanaele h3, .netzwerke h3 { font-size: 1.08rem; margin: 0 0 .5em; }
  .mit-logo { display: flex; align-items: center; gap: 10px; }
  .mit-logo.klein { display: inline-flex; gap: 7px; }
  .kanaele p, .netzwerke p { color: #4c595f; font-size: .93rem; }
  .werkzeuge { list-style: none; margin: auto 0 0; padding: 0; display: grid; gap: 4px; font-size: .9rem; font-weight: 600; }
  .netz-kopf { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .sitz { font-size: .8rem; color: #67747a; }
  .tags { list-style: none; margin: 0 0 10px; padding: 0; display: flex; flex-wrap: wrap; gap: 4px; }
  .tags li { font-size: .75rem; background: #eef2f4; border-radius: 999px; padding: 2px 8px; color: #3f4a4f; }
  .netzwerke a { margin-top: auto; font-weight: 600; font-size: .9rem; }
  .filter { border: 0; padding: 0; margin: 14px 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .filter legend { font-weight: 700; margin-bottom: 6px; font-size: .9rem; }
  .filter label { display: inline-flex; align-items: center; gap: 6px; padding: 5px 11px; border: 1px solid #cfd8dc; border-radius: 999px; background: #fff; font-size: .85rem; font-weight: 600; cursor: pointer; }
  .filter label:has(input:checked) { background: var(--haupt); border-color: var(--haupt); color: #fff; }
  .filter input { position: absolute; opacity: 0; pointer-events: none; }
  .filter label:has(input:focus-visible) { outline: 3px solid var(--akzent); outline-offset: 1px; }
  .treffer { font-size: .85rem; color: #5a676d; margin: 10px 0 0; }
  .stand { font-size: .8rem; color: #67747a; margin: 12px 0 0; }

  .budget { margin-top: 12px; }
  .b-steuerung { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; margin-bottom: 14px; }
  .b-modus { display: flex; border: 1px solid #cfd8dc; border-radius: 8px; overflow: hidden; }
  .b-modus button { font: inherit; font-size: .92rem; font-weight: 600; padding: 7px 14px; border: 0; background: #fff; cursor: pointer; color: #47545a; }
  .b-modus button + button { border-left: 1px solid #cfd8dc; }
  .b-modus button[aria-selected="true"] { background: var(--haupt); color: #fff; }
  .b-feld { display: flex; flex-direction: column; gap: 3px; font-size: .82rem; font-weight: 600; color: #4c595f; }
  .b-feld[hidden] { display: none; }
  .b-feld select, .b-feld input { font: inherit; font-size: .92rem; font-weight: 400; padding: 6px 8px; border: 1px solid #cfd8dc; border-radius: 6px; background: #fff; }
  .b-tabelle-rahmen { overflow-x: auto; position: relative; }
  .b-tabelle { border-collapse: collapse; width: 100%; font-size: .9rem; }
  .b-tabelle th, .b-tabelle td { padding: 6px 6px; border-bottom: 1px solid #eef1f2; text-align: left; white-space: nowrap; }
  .b-tabelle thead th { color: #5a676d; font-weight: 600; border-bottom-color: #dde3e6; }
  .b-tabelle tbody th { display: flex; align-items: center; gap: 8px; font-weight: 400; min-width: 230px; }
  .b-tabelle .zahl { text-align: right; font-variant-numeric: tabular-nums; }
  .b-tabelle tfoot th, .b-tabelle tfoot td { font-weight: 700; border-top: 2px solid #dde3e6; border-bottom: 0; }
  .b-zeilensumme { font-weight: 600; }
  :global(.b-name) { font: inherit; border: 1px solid transparent; border-radius: 6px; padding: 5px 6px; width: 100%; min-width: 180px; background: transparent; }
  :global(.b-name:hover), :global(.b-name:focus) { border-color: #cfd8dc; background: #fff; }
  .b-tabelle :global(input[type="number"]) { font: inherit; width: 92px; text-align: right; padding: 5px 6px; border: 1px solid #cfd8dc; border-radius: 6px; font-variant-numeric: tabular-nums; }
  :global(.b-weg) { font: inherit; font-size: 1.1rem; line-height: 1; border: 0; background: none; color: #9aa6ab; cursor: pointer; padding: 2px 6px; }
