---
// Startseite nach dem Storytelling Framework.
// Die Reihenfolge der Abschnitte ist die Geschichte: nicht umstellen.
// Alle Texte stehen in src/konfiguration.mjs.
import Website from '../layouts/Website.astro';
import CTA from '../components/CTA.astro';
import { konfiguration as k } from '../konfiguration.mjs';
import Bearbeiten from '../components/Bearbeiten.astro';
---
<Website>
  <!-- (3) Hauptbild / Video, (4) Main Headline, (5) Einleitung, (9) CTA -->
  <section class="hero" aria-labelledby="hero-titel">
    {k.hero.video
      ? <video class="hero-medium" src={k.hero.video} autoplay muted loop playsinline aria-hidden="true"></video>
      : <img class="hero-medium" src={k.hero.bild} alt={k.hero.bildAlt} width="1600" height="900" />}
    <div class="hero-text inhalt">
      <h1 id="hero-titel" data-k="hero.ueberschrift">{k.hero.ueberschrift}</h1>
      <p class="einleitung" data-k="hero.einleitung">{k.hero.einleitung}</p>
      <CTA hell zentriert={false} ort="hero" />
    </div>
  </section>

  <!-- (6) Painpoints: 3 bis 6, gemäß Persona -->
  <section id="painpoints" class="abschnitt" aria-labelledby="painpoints-titel">
    <div class="inhalt">
      <h2 id="painpoints-titel" class="zentriert" data-k="painpoints.ueberschrift">{k.painpoints.ueberschrift}</h2>
      <ul class="painpoints">
        {k.painpoints.punkte.map((p, i) => (
          <li><h3 data-k={`painpoints.punkte.${i}.titel`}>{p.titel}</h3><p data-k={`painpoints.punkte.${i}.text`}>{p.text}</p></li>
        ))}
      </ul>
      <CTA ort="painpoints" />
    </div>
  </section>

  <!-- (7) Vorstellung: Autorität, warum wir -->
  <section id="vorstellung" class="abschnitt flaeche" aria-labelledby="vorstellung-titel">
    <div class="inhalt vorstellung">
      <div>
        <h2 id="vorstellung-titel" data-k="vorstellung.ueberschrift">{k.vorstellung.ueberschrift}</h2>
        {k.vorstellung.text.map((absatz, i) => <p data-k={`vorstellung.text.${i}`}>{absatz}</p>)}
        <CTA zentriert={false} ort="vorstellung" />
      </div>
      <img src={k.vorstellung.bild} alt={k.vorstellung.bildAlt} width="600" height="600" loading="lazy" />
    </div>
  </section>

  <!-- (8) Plan: So einfach geht es, 3 Schritte -->
  <section id="plan" class="abschnitt" aria-labelledby="plan-titel">
    <div class="inhalt">
      <h2 id="plan-titel" class="zentriert" data-k="plan.ueberschrift">{k.plan.ueberschrift}</h2>
      <ol class="plan">
        {k.plan.schritte.map((s, i) => (
          <li><span class="nummer" aria-hidden="true">{i + 1}</span><h3 data-k={`plan.schritte.${i}.titel`}>{s.titel}</h3><p data-k={`plan.schritte.${i}.text`}>{s.text}</p></li>
        ))}
      </ol>
      <CTA ort="plan" />
    </div>
  </section>

  <!-- (10) Auszeichnungen / Logos / Siegel: nur wenn vorhanden -->
  {k.auszeichnungen.eintraege.length > 0 && (
    <section id="auszeichnungen" class="abschnitt flaeche schmal" aria-labelledby="auszeichnungen-titel">
      <div class="inhalt">
        <h2 id="auszeichnungen-titel" class="zentriert klein" data-k="auszeichnungen.ueberschrift">{k.auszeichnungen.ueberschrift}</h2>
        <ul class="siegel">
          {k.auszeichnungen.eintraege.map((e, i) => <li data-k={`auszeichnungen.eintraege.${i}`}>{e}</li>)}
        </ul>
      </div>
    </section>
  )}

  <!-- (11) Testimonials -->
  <section id="testimonials" class="abschnitt" aria-labelledby="testimonials-titel">
    <div class="inhalt">
      <h2 id="testimonials-titel" class="zentriert" data-k="testimonials.ueberschrift">{k.testimonials.ueberschrift}</h2>
      <ul class="stimmen">
        {k.testimonials.stimmen.map((s, i) => (
          <li>
            <blockquote><p>„<span data-k={`testimonials.stimmen.${i}.zitat`}>{s.zitat}</span>“</p></blockquote>
            <p class="person"><strong data-k={`testimonials.stimmen.${i}.name`}>{s.name}</strong><br /><span data-k={`testimonials.stimmen.${i}.rolle`}>{s.rolle}</span></p>
          </li>
        ))}
      </ul>
      <CTA ort="testimonials" />
    </div>
  </section>

  <!-- (12) Weitere Elemente: Kontakt (der Footer steht im Layout) -->
  <section id="kontakt" class="abschnitt flaeche" aria-labelledby="kontakt-titel">
    <div class:list={['inhalt kontakt', { 'mit-formular': k.kontakt.formular }]}>
      <div>
      <h2 id="kontakt-titel" data-k="kontakt.ueberschrift">{k.kontakt.ueberschrift}</h2>
      <p data-k="kontakt.text">{k.kontakt.text}</p>
      <ul>
        <li><span>E-Mail</span><a href={`mailto:${k.kontakt.email}`} data-k="kontakt.email">{k.kontakt.email}</a></li>
        <li><span>Telefon</span><a href={`tel:${k.kontakt.telefon.replace(/\s/g, '')}`} data-k="kontakt.telefon">{k.kontakt.telefon}</a></li>
        <li><span>Adresse</span><span data-k="kontakt.adresse">{k.kontakt.adresse}</span></li>
      </ul>
      </div>
      <!-- Kontaktformular über Netlify Forms (kein eigener Server nötig). Gesendete Formulare zählen als Anfrage. -->
      {k.kontakt.formular && (
        <form class="k-form" id="kontakt-formular" name="kontakt" method="POST" data-netlify="true" netlify-honeypot="firma-web" data-erfolg="Danke, Ihre Nachricht ist angekommen. Wir melden uns.">
          <input type="hidden" name="form-name" value="kontakt" />
          <input type="hidden" name="gekommen_ueber" value="" />
          <p class="k-falle"><label>Bitte leer lassen <input name="firma-web" tabindex="-1" autocomplete="off" /></label></p>
          <label>Name<input name="name" required maxlength="120" autocomplete="name" /></label>
          <label>E-Mail<input name="email" type="email" required maxlength="200" autocomplete="email" /></label>
          <label>Nachricht<textarea name="nachricht" rows="4" required maxlength="3000"></textarea></label>
          <p class="k-hinweis">Mit dem Senden verarbeiten wir Ihre Angaben, um Ihre Anfrage zu beantworten. Mehr dazu in der <a href="/datenschutz/">Datenschutzerklärung</a>.</p>
          <button type="submit" class="button">Nachricht senden</button>
          <p class="k-status" data-status aria-live="polite"></p>
        </form>
      )}
    </div>
  </section>
  <Bearbeiten />
</Website>

<style>
  .zentriert { text-align: center; }
  .klein { font-size: 1.1rem; font-weight: 600; color: color-mix(in srgb, var(--text) 70%, transparent); }

  .hero { position: relative; isolation: isolate; min-height: min(78vh, 720px); display: grid; align-items: center; color: #fff; overflow: hidden; }
  .hero-medium { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .hero::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, color-mix(in srgb, var(--haupt) 88%, black) 0%, color-mix(in srgb, var(--haupt) 55%, transparent) 70%, transparent 100%); }
  .hero-text { padding-block: 72px; }
  .hero h1 { max-width: 16ch; }
  .einleitung { font-size: 1.2rem; max-width: 52ch; }

  .abschnitt { padding-block: clamp(56px, 8vw, 96px); }
  .abschnitt.schmal { padding-block: 40px; }
  .flaeche { background: var(--flaeche); }

  .painpoints { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .painpoints li { background: var(--hintergrund); border: 1px solid color-mix(in srgb, var(--text) 12%, transparent); border-left: 4px solid var(--akzent); border-radius: var(--ecken); padding: 20px; }
  .painpoints p { margin: 0; color: color-mix(in srgb, var(--text) 80%, transparent); }

  .vorstellung { display: grid; gap: 40px; grid-template-columns: 1.2fr 1fr; align-items: center; }
  .vorstellung img { border-radius: var(--ecken); width: 100%; }
  @media (max-width: 768px) { .vorstellung { grid-template-columns: 1fr; } }

  .plan { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(3, 1fr); counter-reset: schritt; }
  .plan li { position: relative; background: var(--flaeche); border-radius: var(--ecken); padding: 24px; }
  .plan li:not(:last-child)::after { content: "›"; position: absolute; right: -14px; top: 50%; transform: translateY(-50%); font-size: 2rem; color: var(--akzent); }
  .nummer { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--haupt); color: #fff; font-weight: 700; margin-bottom: 12px; }
  .plan p { margin: 0; }
  @media (max-width: 768px) { .plan { grid-template-columns: 1fr; } .plan li::after { display: none; } }

  .siegel { list-style: none; margin: 1rem 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; }
  .siegel li { min-width: 140px; padding: 18px 20px; border: 2px dashed color-mix(in srgb, var(--text) 25%, transparent); border-radius: var(--ecken); text-align: center; color: color-mix(in srgb, var(--text) 65%, transparent); font-weight: 600; }

  .stimmen { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .stimmen li { border: 1px solid color-mix(in srgb, var(--text) 12%, transparent); border-radius: var(--ecken); padding: 24px; display: flex; flex-direction: column; justify-content: space-between; }
  .stimmen blockquote { margin: 0; font-size: 1.1rem; }
  .person { margin: 0; color: color-mix(in srgb, var(--text) 70%, transparent); font-size: .95rem; }

  .kontakt ul { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; gap: 10px; }
  .kontakt li { display: grid; grid-template-columns: 7rem 1fr; gap: 12px; }
  .kontakt span { font-weight: 600; }
  .kontakt.mit-formular { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: start; }
  @media (max-width: 760px) { .kontakt.mit-formular { grid-template-columns: 1fr; gap: 28px; } }
  .k-form { display: grid; gap: 14px; background: #fff; border: 1px solid color-mix(in srgb, var(--text) 12%, transparent); border-radius: var(--ecken); padding: 24px; }
  .k-form label { display: grid; gap: 5px; font-weight: 600; font-size: .95rem; }
  .k-form input, .k-form textarea { font: inherit; padding: .6em .7em; border: 1px solid color-mix(in srgb, var(--text) 30%, transparent); border-radius: calc(var(--ecken) * .6); background: #fff; color: var(--text); width: 100%; box-sizing: border-box; }
  .k-form input:focus-visible, .k-form textarea:focus-visible { outline: 3px solid var(--akzent); outline-offset: 1px; }
  .k-form .button { justify-self: start; cursor: pointer; font: inherit; font-weight: 700; }
  .k-form .button:disabled { opacity: .6; cursor: wait; }
  .k-falle { position: absolute; left: -9999px; }
  .k-hinweis { font-size: .85rem; margin: 0; color: color-mix(in srgb, var(--text) 75%, transparent); }
  .k-status { margin: 0; font-weight: 600; min-height: 1.4em; }
  .k-status.ok { color: #22663a; }
  .k-status.fehler { color: #8e2f2f; }
  @media (max-width: 480px) { .kontakt li { grid-template-columns: 1fr; gap: 0; } }
</style>
