---
// Kleine Navigation zwischen Unterseiten eines Reiters (z. B. Promotion).
interface Props { seiten: { name: string; pfad: string }[] }
const { seiten } = Astro.props;
const aktuell = Astro.url.pathname.replace(/\/?$/, '/');
---
<nav class="unterseiten" aria-label="Unterseiten">
  {seiten.map((s) => <a href={s.pfad} aria-current={aktuell === s.pfad ? 'page' : undefined}>{s.name}</a>)}
</nav>

<style>
  .unterseiten { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .unterseiten a { padding: 8px 14px; border-radius: 999px; background: #fff; border: 1px solid #dde3e6; text-decoration: none; font-weight: 600; font-size: .92rem; color: #47545a; }
  .unterseiten a[aria-current="page"] { background: var(--haupt); border-color: var(--haupt); color: #fff; }
</style>
