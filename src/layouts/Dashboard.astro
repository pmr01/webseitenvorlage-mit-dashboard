---
// Rahmen für das Dashboard: sechs Reiter nach dem 6P-Prinzip.
// Performance ist die Startansicht. Das Dashboard steht nicht in der Navigation der Website.
import '../styles/global.css';
import Farben from '../components/Farben.astro';
import { konfiguration } from '../konfiguration.mjs';

interface Props { titel: string; untertitel?: string }
const { titel, untertitel } = Astro.props;

const reiter = [
  { name: 'Performance', pfad: '/dashboard/' },
  { name: 'Produkt', pfad: '/dashboard/produkt/' },
  { name: 'Positionierung', pfad: '/dashboard/positionierung/' },
  { name: 'Promotion', pfad: '/dashboard/promotion/' },
  { name: 'Prozess', pfad: '/dashboard/prozess/' },
  { name: 'Plattform', pfad: '/dashboard/plattform/' },
];
const aktuell = Astro.url.pathname.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titel} | Dashboard | {konfiguration.firma.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Farben />
  </head>
  <body class="dashboard">
    <header class="d-kopf">
      <div class="d-breite d-kopf-zeile">
        <a class="d-marke" href="/dashboard/">
          <img src={konfiguration.firma.logo} alt="" width="32" height="32" />
          <span>{konfiguration.firma.name} <small>Dashboard</small></span>
        </a>
        <div class="d-links">
          <a href="/dashboard/anleitungen/" aria-current={aktuell.startsWith('/dashboard/anleitungen/') ? 'page' : undefined}>Anleitungen</a>
          <a href="/">Zur Website</a>
        </div>
      </div>
      <nav class="d-breite d-reiter" aria-label="6P-Bereiche">
        <ol>
          {reiter.map((r, i) => (
            <li>
              <a href={r.pfad} aria-current={aktuell === r.pfad ? 'page' : undefined}>
                <span class="d-nr" aria-hidden="true">{i === 0 ? '★' : i}</span>{r.name}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </header>

    <main class="d-breite d-inhalt">
      <div class="d-titel">
        <h1>{titel}</h1>
        {untertitel && <p>{untertitel}</p>}
      </div>
      <slot />
    </main>

    <footer class="d-breite d-fuss">
      <p>Das Dashboard ist bei Netlify durch ein Passwort geschützt und für Suchmaschinen gesperrt. In der lokalen Vorschau gilt der Passwortschutz nicht.</p>
    </footer>
  </body>
</html>

<style is:global>
  body.dashboard { background: #f4f6f7; font-size: 1rem; }
  .d-breite { width: min(1240px, 100% - 32px); margin-inline: auto; }
  .d-kopf { background: #fff; border-bottom: 1px solid #dde3e6; position: sticky; top: 0; z-index: 10; }
  .d-kopf-zeile { display: flex; justify-content: space-between; align-items: center; padding-block: 12px; gap: 12px; }
  .d-marke { display: flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none; font-weight: 700; }
  .d-marke small { font-weight: 500; color: #67747a; margin-left: 4px; }
  .d-links { display: flex; gap: 16px; font-size: .95rem; }
  .d-links a { white-space: nowrap; }
  .d-links a[aria-current="page"] { font-weight: 700; text-decoration: none; }
  @media (max-width: 480px) { .d-marke small { display: none; } .d-links { gap: 12px; font-size: .88rem; } }
  .d-reiter { overflow-x: auto; }
  .d-reiter ol { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .d-reiter a { display: flex; align-items: center; gap: 8px; padding: 10px 14px; color: #47545a; text-decoration: none; font-weight: 600; white-space: nowrap; border-bottom: 3px solid transparent; }
  .d-reiter a:hover { color: var(--haupt); }
  .d-reiter a[aria-current="page"] { color: var(--haupt); border-bottom-color: var(--haupt); }
  .d-nr { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: #e7ecee; font-size: .75rem; }
  a[aria-current="page"] .d-nr { background: var(--haupt); color: #fff; }

  .d-inhalt { padding-block: 28px 40px; }
  .d-titel { margin-bottom: 20px; }
  .d-titel h1 { font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: .25em; }
  .d-titel p { color: #5a676d; margin: 0; max-width: 70ch; }
  .d-fuss { padding-block: 0 32px; color: #67747a; font-size: .85rem; }

  /* Bausteine für alle Reiter */
  .karte { background: #fff; border: 1px solid #dde3e6; border-radius: 12px; padding: 20px; }
  .karte h2 { font-size: 1.15rem; margin-bottom: .75em; }
  .karte h3 { font-size: 1rem; margin-bottom: .4em; }
  .beispiel-hinweis { display: flex; gap: 10px; align-items: flex-start; background: #fff4dd; border: 1px solid #f0d199; border-radius: 10px; padding: 12px 16px; margin-bottom: 20px; font-size: .95rem; }
  .beispiel-hinweis strong { white-space: nowrap; }
  .beispiel-hinweis code { font-size: .9em; background: #fff; padding: 0 .3em; border-radius: 4px; }
  .punkte { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .punkte li { line-height: 1.4; }
  .punkte strong { display: block; }
  .punkte span { color: #5a676d; font-size: .92rem; }
  .fazit { margin-top: 16px; color: #3d494e; font-style: italic; }
  .abschnitt-modell { margin-bottom: 36px; }
  .abschnitt-modell > h2 { font-size: 1.35rem; margin-bottom: .6em; }
</style>
